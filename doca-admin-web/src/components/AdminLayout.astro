---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = "DOCA Admin Panel" } = Astro.props;

// Supabase Credentials
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const geminiApiKey = import.meta.env.PUBLIC_GEMINI_API_KEY || '';
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/images/brand/symbol-green.png" />
		<title>{title}</title>
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Mono&display=swap" rel="stylesheet">
		
		<!-- Phosphor Icons CDN -->
		<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css" />
		<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/light/style.css" />
		<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/fill/style.css" />
	</head>
	<body class="notion-body">
		<!-- SCRIPT CHẶN LOCK SỚM -->
		<script is:inline>
			(function() {
				const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
				let sessionStr = localStorage.getItem('doca_admin_session');
				
				// Tự động cấp quyền Dev Sandbox trên localhost nếu chưa có session SSO
				if (!sessionStr && isLocal) {
					const devSession = {
						email: 'admin-local@doca.pet',
						access_token: 'dev_mock_sandbox_token',
						expires_at: Math.floor(Date.now() / 1000) + 86400 * 365
					};
					localStorage.setItem('doca_admin_session', JSON.stringify(devSession));
					sessionStr = JSON.stringify(devSession);
				}

				if (!sessionStr) {
					window.location.replace('/login');
					return;
				}
				
				try {
					const session = JSON.parse(sessionStr);
					if (session.expires_at && Date.now() / 1000 >= session.expires_at) {
						localStorage.removeItem('doca_admin_session');
						window.location.replace('/login');
						return;
					}
				} catch (e) {
					localStorage.removeItem('doca_admin_session');
					window.location.replace('/login');
				}
			})();
		</script>

		<!-- Inject credentials sang client-side -->
		<script is:inline define:vars={{ supabaseUrl, supabaseKey, geminiApiKey }}>
			window.PUBLIC_SUPABASE_URL = supabaseUrl;
			window.PUBLIC_SUPABASE_ANON_KEY = supabaseKey;
			window.PUBLIC_GEMINI_API_KEY = geminiApiKey;
		</script>

		<div class="notion-layout-grid">
			<!-- SIDEBAR TRÁI - PHONG CÁCH NOTION (PAPER NỀN GIẤY) -->
			<aside class="notion-sidebar">
				<!-- Header của Notion (Workspace Switcher) với Logo thương hiệu ngang -->
				<div class="notion-sidebar-header" style="display: flex; flex-direction: column; align-items: flex-start; gap: 4px; padding: 12px 14px 8px 14px; margin-bottom: 12px; border-bottom: 1px solid var(--notion-border); position: relative;">
					<img src="/images/brand/logo-light.png" alt="DOCA Logo" style="height: 24px; object-fit: contain;" onerror="this.src='https://capcat.vn/images/brand/logo-light.png'" />
					<div class="notion-workspace-plan" style="font-size: 10px; color: var(--notion-text-light); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-top: 2px;">Góc Vận Hành Admin</div>
					<button class="notion-icon-btn mobile-sidebar-close-btn" style="position: absolute; right: 12px; top: 12px; display: none;" aria-label="Đóng sidebar" onclick="document.querySelector('.notion-layout-grid').classList.add('sidebar-collapsed'); localStorage.setItem('notion_sidebar_collapsed', 'true');">
						<i class="ph-light ph-x" style="font-size: 16px;"></i>
					</button>
				</div>

				<!-- Menu 2 Cấp -->
				<nav class="notion-sidebar-nav">
					
					<!-- Cấp 1: Nhóm Quiz Mèo -->
					<div class="notion-menu-group">
						<div class="notion-group-title active-group">
							<i class="ph-light ph-caret-down notion-toggle-icon"></i>
							<i class="ph-light ph-paw"></i>
							<span>Quiz Mèo</span>
						</div>
						<div class="notion-group-items">
							<a href="/quizzes" class="notion-nav-item" id="nav-quizzes">
								<i class="ph-light ph-notebook"></i>
								<span>Quản lý Quiz</span>
							</a>
							<a href="/leads" class="notion-nav-item" id="nav-leads">
								<i class="ph-light ph-users"></i>
								<span>Danh sách Lead</span>
							</a>
							<a href="/kiosks" class="notion-nav-item" id="nav-kiosks">
								<i class="ph-light ph-storefront"></i>
								<span>Duyệt Kiosk</span>
							</a>
						</div>
					</div>

					<!-- Cấp 1: Nhóm Blog (Dự phòng tương lai) -->
					<div class="notion-menu-group">
						<div class="notion-group-title">
							<i class="ph-light ph-caret-right notion-toggle-icon"></i>
							<i class="ph-light ph-article"></i>
							<span>Blog (Sắp ra mắt)</span>
						</div>
						<div class="notion-group-items hidden-items">
							<a href="#" class="notion-nav-item disabled-item">
								<i class="ph-light ph-pencil-simple-line"></i>
								<span>Quản lý bài viết</span>
							</a>
							<a href="#" class="notion-nav-item disabled-item">
								<i class="ph-light ph-squares-four"></i>
								<span>Danh mục Blog</span>
							</a>
						</div>
					</div>

					<!-- Cấp 1: Nhóm User (Dự phòng tương lai) -->
					<div class="notion-menu-group">
						<div class="notion-group-title">
							<i class="ph-light ph-caret-right notion-toggle-icon"></i>
							<i class="ph-light ph-user-circle"></i>
							<span>Thành viên (User)</span>
						</div>
						<div class="notion-group-items hidden-items">
							<a href="#" class="notion-nav-item disabled-item">
								<i class="ph-light ph-user-list"></i>
								<span>Quản lý Admin</span>
							</a>
						</div>
					</div>

					<div class="notion-nav-divider"></div>

					<!-- External link quay lại trang chủ -->
					<a href="https://capcat.vn" class="notion-nav-item" target="_blank" style="margin-top: 4px;">
						<i class="ph-light ph-house"></i>
						<span>Xem Trang chủ</span>
						<i class="ph-light ph-arrow-up-right" style="font-size: 0.75rem; margin-left: auto; color: var(--notion-text-light);"></i>
					</a>
				</nav>

				<!-- Footer Sidebar chứa email và Đăng xuất -->
				<div class="notion-sidebar-footer">
					<div class="notion-user-badge" id="admin-user-email">admin@doca.pet</div>
					<button id="admin-logout-btn" class="notion-logout-btn">
						<i class="ph-light ph-sign-out"></i> Đăng xuất
					</button>
				</div>
			</aside>

			<!-- KHU VỰC NỘI DUNG PHẢI - MÀU MÂY (CLOUD) THOÁNG ĐÃNG -->
			<main class="notion-content-area">
				<!-- Thanh Top Bar với nút đóng/mở Sidebar và status badge logo -->
				<header class="notion-top-bar" style="display: flex; align-items: center; justify-content: space-between; height: 45px; padding: 0 24px; box-sizing: border-box; width: 100%;">
					<div style="display: flex; align-items: center; gap: 12px;">
						<button id="sidebar-toggle-btn" class="notion-icon-btn" title="Ẩn/hiện Sidebar">
							<i class="ph-light ph-sidebar" style="font-size: 16px;"></i>
						</button>
						<div class="notion-breadcrumb">
							<span class="breadcrumb-parent">Doca Workspace</span>
							<span class="breadcrumb-separator">/</span>
							<span class="breadcrumb-current" id="notion-breadcrumb-current">{title}</span>
						</div>
					</div>
					<!-- Chỉ hiển thị trạng thái kết nối đơn giản, tiết chế màu sắc -->
					<div style="display: flex; align-items: center; gap: 6px;">
						<span style="font-size: 11px; font-weight: 500; color: var(--notion-text-light); text-transform: uppercase; letter-spacing: 0.05em;">Hệ thống</span>
						<div style="width: 6px; height: 6px; border-radius: 50%; background-color: var(--doca-sprout); box-shadow: 0 0 4px var(--doca-sprout);"></div>
					</div>
				</header>
				
				<!-- Thân nội dung Notion (Tiêu đề chữ thuần túy, sạch sẽ, rộng rãi) -->
				<div class="notion-main-body">
					<h1 class="notion-page-title">{title}</h1>
					<div class="notion-page-content">
						<slot />
					</div>
				</div>
			</main>
		</div>

		<!-- Global Toast Container cho Admin -->
		<div id="cozy-toast-element" class="cozy-toast">
			<i class="ph-light ph-check" style="font-size: 1rem; color: var(--notion-text-main); flex-shrink: 0;"></i>
			<span id="cozy-toast-text"></span>
		</div>
	</body>
</html>

<!-- CLIENT-SIDE NOTION INTERACTION SCRIPT -->
<script>
	import { createClient } from '@supabase/supabase-js';

	document.addEventListener('DOMContentLoaded', async () => {
		const supabaseUrl = window.PUBLIC_SUPABASE_URL || '';
		const supabaseKey = window.PUBLIC_SUPABASE_ANON_KEY || '';

		const sessionStr = localStorage.getItem('doca_admin_session');
		if (!sessionStr) return;

		const session = JSON.parse(sessionStr);
		
		const emailBadge = document.getElementById('admin-user-email');
		if (emailBadge && session.email) {
			emailBadge.innerText = session.email;
		}

		// Đánh dấu active cho link menu dựa vào đường dẫn hiện tại
		const path = window.location.pathname;
		if (path.includes('/quizzes')) {
			document.getElementById('nav-quizzes')?.classList.add('active');
		} else if (path.includes('/leads')) {
			document.getElementById('nav-leads')?.classList.add('active');
		} else if (path.includes('/kiosks')) {
			document.getElementById('nav-kiosks')?.classList.add('active');
		}

		// Tải trạng thái Sidebar ẩn/hiện từ LocalStorage
		const layoutGrid = document.querySelector('.notion-layout-grid');
		const isCollapsed = localStorage.getItem('notion_sidebar_collapsed') === 'true';
		if (isCollapsed && layoutGrid) {
			layoutGrid.classList.add('sidebar-collapsed');
		}

		// Bắt sự kiện ẩn/hiện Sidebar
		const toggleBtn = document.getElementById('sidebar-toggle-btn');
		toggleBtn?.addEventListener('click', () => {
			if (layoutGrid) {
				layoutGrid.classList.toggle('sidebar-collapsed');
				const nowCollapsed = layoutGrid.classList.contains('sidebar-collapsed');
				localStorage.setItem('notion_sidebar_collapsed', String(nowCollapsed));
			}
		});

		// Xử lý collapse/expand danh mục kiểu Notion
		document.querySelectorAll('.notion-group-title').forEach(header => {
			header.addEventListener('click', () => {
				const group = header.parentElement;
				const items = group.querySelector('.notion-group-items');
				const toggleIcon = header.querySelector('.notion-toggle-icon');

				if (items.classList.contains('hidden-items')) {
					items.classList.remove('hidden-items');
					header.classList.add('active-group');
					toggleIcon.className = 'ph-light ph-caret-down notion-toggle-icon';
				} else {
					items.classList.add('hidden-items');
					header.classList.remove('active-group');
					toggleIcon.className = 'ph-light ph-caret-right notion-toggle-icon';
				}
			});
		});

		const supabase = (supabaseUrl && supabaseKey) ? createClient(supabaseUrl, supabaseKey) : null;

		const logoutBtn = document.getElementById('admin-logout-btn');
		logoutBtn?.addEventListener('click', async () => {
			if (confirm("Cô/chú có thực sự muốn đăng xuất?")) {
				if (supabase) { try { await supabase.auth.signOut(); } catch(e){} }
				localStorage.removeItem('doca_admin_session');
				window.location.replace('/login');
			}
		});

		window.showToast = (message: string) => {
			const toast = document.getElementById('cozy-toast-element');
			const toastText = document.getElementById('cozy-toast-text');
			if (toast && toastText) {
				toastText.innerText = message;
				toast.classList.add('show');
				setTimeout(() => {
					toast.classList.remove('show');
				}, 3000);
			}
		};
	});
</script>

<style is:global>
	/* --- THIẾT KẾ TOÀN DIỆN PHONG CÁCH NOTION (BỘ MÀU THƯƠNG HIỆU DOCA) --- */
	:root {
		/* Phối màu thương hiệu Doca chuẩn */
		--doca-charcoal: #15170F;        /* Màu mực than đậm (Charcoal) */
		--doca-cloud: #FBFAF6;           /* Màu mây trắng sữa (Cloud) */
		--doca-paper: #F4F1E9;           /* Màu nền giấy mộc mạc (Paper) */
		--doca-sand: #E8E3D6;            /* Màu cát ấm viền (Sand) */
		--doca-sprout: #76C123;          /* Màu xanh đâm chồi nhấn (Sprout) */
		--doca-forest: #3C5E16;          /* Xanh rừng sâu hỗ trợ */

		/* Áp các màu thương hiệu vào biến layout Notion */
		--notion-bg: var(--doca-cloud);
		--notion-bg-sidebar: var(--doca-paper);
		--notion-text-main: var(--doca-charcoal);
		--notion-text-light: rgba(21, 23, 15, 0.55);
		--notion-text-disabled: rgba(21, 23, 15, 0.3);
		--notion-border: var(--doca-sand);
		--notion-hover-bg: rgba(21, 23, 15, 0.04);
		--notion-active-bg: rgba(21, 23, 15, 0.08);
		
		--notion-radius: 3px;
	}

	body.notion-body {
		background-color: var(--notion-bg);
		color: var(--notion-text-main);
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: 13.5px;
		line-height: 1.5;
		margin: 0;
		padding: 0;
		min-height: 100vh;
		overflow-x: hidden;
	}

	.notion-layout-grid {
		display: flex;
		min-height: 100vh;
		width: 100%;
		transition: all 0.2s ease;
	}

	/* --- NOTION SIDEBAR (PAPER BACKGROUND) --- */
	.notion-sidebar {
		background: var(--notion-bg-sidebar);
		border-right: 1px solid var(--notion-border);
		padding: 10px 12px;
		display: flex;
		flex-direction: column;
		height: 100vh;
		position: sticky;
		top: 0;
		width: 240px;
		min-width: 240px;
		box-sizing: border-box;
		transition: margin-left 0.2s ease, opacity 0.2s ease;
		z-index: 100;
	}

	.notion-layout-grid.sidebar-collapsed .notion-sidebar {
		margin-left: -240px;
		opacity: 0;
		pointer-events: none;
	}

	.notion-sidebar-header {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 8px;
		border-radius: var(--notion-radius);
		cursor: pointer;
		margin-bottom: 12px;
		transition: background 0.15s ease;
	}

	.notion-sidebar-header:hover {
		background: var(--notion-hover-bg);
	}

	.notion-workspace-logo {
		width: 24px;
		height: 24px;
		border-radius: 3px;
	}

	.notion-workspace-info {
		overflow: hidden;
	}

	.notion-workspace-name {
		font-weight: 600;
		font-size: 13px;
		color: var(--notion-text-main);
		white-space: nowrap;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	.notion-workspace-plan {
		font-size: 11px;
		color: var(--notion-text-light);
	}

	/* Menu 2 Cấp */
	.notion-sidebar-nav {
		display: flex;
		flex-direction: column;
		gap: 2px;
		flex-grow: 1;
		overflow-y: auto;
	}

	.notion-menu-group {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	.notion-group-title {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 11.5px;
		font-weight: 500;
		color: var(--notion-text-light);
		padding: 4px 8px;
		border-radius: var(--notion-radius);
		cursor: pointer;
		user-select: none;
		transition: background 0.1s ease;
	}

	.notion-group-title:hover {
		background: var(--notion-hover-bg);
	}

	.notion-toggle-icon {
		font-size: 9px;
		color: var(--notion-text-light);
		width: 10px;
		transition: transform 0.1s ease;
	}

	.notion-group-items {
		display: flex;
		flex-direction: column;
		gap: 1px;
		padding-left: 14px;
	}

	.notion-group-items.hidden-items {
		display: none;
	}

	.notion-nav-item {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 4px 8px;
		border-radius: var(--notion-radius);
		color: var(--notion-text-main);
		text-decoration: none;
		font-size: 12.5px;
		font-weight: 400;
		transition: background 0.1s ease;
	}

	.notion-nav-item:hover:not(.disabled-item) {
		background: var(--notion-hover-bg);
	}

	.notion-nav-item.active {
		background: rgba(118, 193, 35, 0.08); /* Sprout Green Nhạt Nhấn Active */
		color: var(--doca-forest);
		font-weight: 600;
	}

	.disabled-item {
		color: var(--notion-text-disabled);
		cursor: not-allowed;
	}

	.notion-nav-divider {
		height: 1px;
		background: var(--notion-border);
		margin: 6px 8px;
	}

	.notion-sidebar-footer {
		border-top: 1px solid var(--notion-border);
		padding-top: 8px;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.notion-user-badge {
		font-size: 11px;
		color: var(--notion-text-light);
		padding: 2px 8px;
		text-align: center;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.notion-logout-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		background: transparent;
		border: 1px solid var(--notion-border);
		color: var(--notion-text-light);
		font-family: inherit;
		font-size: 11.5px;
		font-weight: 500;
		padding: 5px;
		border-radius: var(--notion-radius);
		cursor: pointer;
		transition: all 0.1s ease;
	}

	.notion-logout-btn:hover {
		background: rgba(211, 47, 47, 0.06);
		color: #d32f2f;
		border-color: rgba(211, 47, 47, 0.2);
	}

	/* --- NOTION CONTENT (CLOUD BACKGROUND) --- */
	.notion-content-area {
		display: flex;
		flex-direction: column;
		flex-grow: 1;
		height: 100vh;
		overflow-y: auto;
		background: var(--notion-bg);
		transition: all 0.2s ease;
	}

	.notion-top-bar {
		padding: 8px 24px;
		border-bottom: 1px solid var(--notion-border);
		display: flex;
		align-items: center;
		background: var(--notion-bg);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.notion-icon-btn {
		background: transparent;
		border: none;
		cursor: pointer;
		width: 26px;
		height: 26px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--notion-text-light);
		border-radius: var(--notion-radius);
		transition: background 0.1s ease, color 0.1s ease;
		padding: 0;
	}

	.notion-icon-btn:hover {
		background: var(--notion-hover-bg);
		color: var(--notion-text-main);
	}

	.notion-breadcrumb {
		font-size: 11.5px;
		color: var(--notion-text-light);
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.breadcrumb-separator {
		color: var(--notion-text-disabled);
	}

	.breadcrumb-current {
		color: var(--notion-text-main);
		font-weight: 500;
	}

	/* Tối ưu không gian main body cực rộng - FULL WIDTH chuẩn Notion */
	.notion-main-body {
		flex-grow: 1;
		padding: 20px 40px;
		max-width: 100%;
		width: 100%;
		box-sizing: border-box;
	}

	.notion-page-title {
		font-size: 24px;
		font-weight: 700;
		color: var(--notion-text-main);
		margin-top: 0;
		margin-bottom: 16px;
		letter-spacing: -0.02em;
		border-bottom: 1px solid var(--notion-border);
		padding-bottom: 10px;
	}

	/* --- CẤU HÌNH TABLE COMPACT NOTION --- */
	.notion-table-wrapper {
		margin-bottom: 20px;
		border-top: 1px solid var(--notion-border);
		overflow-x: auto;
	}

	.notion-table {
		width: 100%;
		border-collapse: collapse;
		text-align: left;
		font-size: 13px;
	}

	.notion-table th {
		color: var(--notion-text-light);
		font-weight: 500;
		padding: 8px 10px;
		border-bottom: 1px solid var(--notion-border);
