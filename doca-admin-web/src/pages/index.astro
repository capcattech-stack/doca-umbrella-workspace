---
// Trang chủ quản trị tự động chuyển hướng
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <title>DOCA Admin Redirecting...</title>
  <script is:inline>
    (function() {
      const sessionStr = localStorage.getItem('doca_admin_session');
      if (sessionStr) {
        try {
          const session = JSON.parse(sessionStr);
          if (session.expires_at && Date.now() / 1000 < session.expires_at) {
            window.location.replace('/quizzes');
            return;
          }
        } catch (e) {}
      }
      window.location.replace('/login');
    })();
  </script>
</head>
<body>
  <div style="font-family: sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; color: #6E6E73;">
    Đang tải trang quản trị...
  </div>
</body>
</html>
