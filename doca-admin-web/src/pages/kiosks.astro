---
import AdminLayout from '../components/AdminLayout.astro';

// Supabase Credentials
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---

<AdminLayout title="Duyệt Đăng Ký Creator Kiosk">
  <!-- TABS ĐỂ LỌC TRẠNG THÁI KIỂU NOTION -->
  <div class="notion-tabs-container" style="display: flex; gap: 8px; margin-bottom: 20px; border-bottom: 1px solid var(--notion-border); padding-bottom: 8px;">
    <button class="notion-tab-btn active" data-status="all">Tất cả</button>
    <button class="notion-tab-btn" data-status="pending">Chờ duyệt <span id="count-pending" class="tab-count-badge">0</span></button>
    <button class="notion-tab-btn" data-status="approved">Đã duyệt <span id="count-approved" class="tab-count-badge">0</span></button>
    <button class="notion-tab-btn" data-status="rejected">Từ chối <span id="count-rejected" class="tab-count-badge">0</span></button>
  </div>

  <!-- NOTION ACTION BAR -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; gap: 16px;">
    <div style="position: relative; max-width: 320px; width: 100%;">
      <span style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--notion-text-light); z-index: 2;">
        <i class="ph-light ph-magnifying-glass" style="font-size: 15px;"></i>
      </span>
      <input type="text" id="kiosk-search-input" class="notion-input" placeholder="Tìm theo email hoặc tên kiosk..." style="padding-left: 32px;" />
    </div>
  </div>

  <!-- NOTION TABLE -->
  <div class="notion-table-wrapper">
    <table class="notion-table">
      <thead>
        <tr>
          <th style="width: 25%;">Email</th>
          <th style="width: 20%;">Tên Kiosk (Slug)</th>
          <th style="width: 25%;">Kênh Truyền Thông</th>
          <th style="width: 12%;">Trạng Thái</th>
          <th style="width: 18%; text-align: right; padding-right: 16px;">Hành Động</th>
        </tr>
      </thead>
      <tbody id="kiosks-table-body">
        <tr>
          <td colspan="5" style="text-align: center; color: var(--notion-text-light); padding: 32px;">
            <i class="ph-light ph-circle-notch spinner-icon spin" style="font-size: 16px; margin-right: 6px;"></i> Đang tải danh sách Kiosk...
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- MODAL TỪ CHỐI DUYỆT KIOSK -->
  <div id="reject-modal" class="notion-modal hidden">
    <div class="notion-modal-content">
      <div class="notion-modal-header">
        <h3>Lý do từ chối đăng ký</h3>
        <button id="close-modal-btn" class="notion-modal-close-btn">&times;</button>
      </div>
      <div class="notion-modal-body" style="padding-top: 12px;">
        <input type="hidden" id="reject-kiosk-id" />
        <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
          <label for="reject-reason-input" style="font-size: 12px; font-weight: 600; color: var(--notion-text-light);">Nhập lý do gửi cho Creator:</label>
          <textarea id="reject-reason-input" class="notion-textarea" placeholder="Ví dụ: Kênh truyền thông của bạn không hoạt động hoặc không phù hợp với tiêu chuẩn nội dung..." rows="3" style="width: 100%; font-family: inherit; font-size: 13px;"></textarea>
        </div>
      </div>
      <div class="notion-modal-footer" style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px;">
        <button id="cancel-reject-btn" class="notion-btn notion-btn-secondary">Hủy bỏ</button>
        <button id="confirm-reject-btn" class="notion-btn notion-btn-danger">Xác nhận Từ chối</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  document.addEventListener('DOMContentLoaded', async () => {
    const supabaseUrl = window.PUBLIC_SUPABASE_URL || '';
    const supabaseKey = window.PUBLIC_SUPABASE_ANON_KEY || '';

    const sessionStr = localStorage.getItem('doca_admin_session');
    if (!sessionStr) return;

    const session = JSON.parse(sessionStr);
    const supabase = createClient(supabaseUrl, supabaseKey, {
      global: {
        headers: {
          Authorization: `Bearer ${session.access_token}`
        }
      }
    });

    const kiosksTableBody = document.getElementById('kiosks-table-body');
    const searchInput = document.getElementById('kiosk-search-input') as HTMLInputElement;
    const tabBtns = document.querySelectorAll('.notion-tab-btn');
    
    // Modal elements
    const rejectModal = document.getElementById('reject-modal');
    const rejectKioskIdInput = document.getElementById('reject-kiosk-id') as HTMLInputElement;
    const rejectReasonInput = document.getElementById('reject-reason-input') as HTMLTextAreaElement;
    const confirmRejectBtn = document.getElementById('confirm-reject-btn');
    const cancelRejectBtn = document.getElementById('cancel-reject-btn');
    const closeModalBtn = document.getElementById('close-modal-btn');

    let allKiosks = [];
    let filteredKiosks = [];
    let currentFilterStatus = 'all'; // 'all' | 'pending' | 'approved' | 'rejected'

    // Tải dữ liệu Kiosk
    const loadKiosks = async () => {
      kiosksTableBody.innerHTML = `
        <tr>
          <td colspan="5" style="text-align: center; color: var(--notion-text-light); padding: 32px;">
            <i class="ph-light ph-circle-notch spinner-icon spin" style="font-size: 16px; margin-right: 6px;"></i> Đang tải danh sách Kiosk...
          </td>
        </tr>
      `;

      const { data, error } = await supabase
        .from('creator_kiosks')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) {
        kiosksTableBody.innerHTML = `
          <tr>
            <td colspan="5" style="text-align: center; color: #ff4d4f; padding: 20px;">
              <i class="ph-light ph-warning-circle" style="font-size: 16px; margin-right: 6px;"></i> Lỗi tải danh sách: ${error.message}
            </td>
          </tr>
        `;
        return;
      }

      allKiosks = data || [];
      updateCounts();
      filterAndRender();
    };

    // Cập nhật số lượng đếm trên Tabs
    function updateCounts() {
      const pendingCount = allKiosks.filter(k => k.status === 'pending').length;
      const approvedCount = allKiosks.filter(k => k.status === 'approved').length;
      const rejectedCount = allKiosks.filter(k => k.status === 'rejected').length;

      const pBadge = document.getElementById('count-pending');
      const aBadge = document.getElementById('count-approved');
      const rBadge = document.getElementById('count-rejected');

      if (pBadge) pBadge.innerText = String(pendingCount);
      if (aBadge) aBadge.innerText = String(approvedCount);
      if (rBadge) rBadge.innerText = String(rejectedCount);
    }

    // Lọc và Render bảng
    function filterAndRender() {
      const searchVal = searchInput.value.trim().toLowerCase();
      
      filteredKiosks = allKiosks.filter(k => {
        const matchesStatus = currentFilterStatus === 'all' || k.status === currentFilterStatus;
        const matchesSearch = k.email.toLowerCase().includes(searchVal) || k.kios_name.toLowerCase().includes(searchVal);
        return matchesStatus && matchesSearch;
      });

      renderTable(filteredKiosks);
    }

    // Render HTML bảng
    function renderTable(items) {
      if (items.length === 0) {
        kiosksTableBody.innerHTML = `
          <tr>
            <td colspan="5" style="text-align: center; color: var(--notion-text-light); padding: 32px;">
              Không tìm thấy bản ghi Kiosk nào.
            </td>
          </tr>
        `;
        return;
      }

      kiosksTableBody.innerHTML = items.map(kiosk => {
        let statusTag = '';
        let actionButtons = '';

        if (kiosk.status === 'pending') {
          statusTag = '<span class="notion-tag status-pending"><i class="ph-light ph-clock" style="margin-right: 3px;"></i> Chờ duyệt</span>';
          actionButtons = `
            <button class="notion-btn btn-approve" data-id="${kiosk.id}" style="padding: 3px 8px; font-size: 11.5px; background-color: var(--doca-sprout); color: #fff; border: none; margin-right: 4px;">Duyệt</button>
            <button class="notion-btn btn-reject-trigger" data-id="${kiosk.id}" style="padding: 3px 8px; font-size: 11.5px; background-color: #ff4d4f; color: #fff; border: none;">Từ chối</button>
          `;
        } else if (kiosk.status === 'approved') {
          statusTag = '<span class="notion-tag status-approved"><i class="ph-fill ph-check-circle" style="margin-right: 3px;"></i> Đã duyệt</span>';
          actionButtons = `
            <button class="notion-btn btn-pending" data-id="${kiosk.id}" style="padding: 3px 8px; font-size: 11.5px; background-color: var(--notion-bg-sidebar); border: 1px solid var(--notion-border); color: var(--notion-text-main); margin-right: 4px;">Thu hồi</button>
            <button class="notion-btn btn-delete" data-id="${kiosk.id}" style="padding: 3px 8px; font-size: 11.5px; background-color: #ff4d4f; color: #fff; border: none;"><i class="ph-light ph-trash"></i></button>
          `;
        } else if (kiosk.status === 'rejected') {
          statusTag = `<span class="notion-tag status-rejected" title="Lý do: ${kiosk.rejection_reason || 'Không rõ'}"><i class="ph-light ph-warning-circle" style="margin-right: 3px;"></i> Bị từ chối</span>`;
          actionButtons = `
            <button class="notion-btn btn-pending" data-id="${kiosk.id}" style="padding: 3px 8px; font-size: 11.5px; background-color: var(--notion-bg-sidebar); border: 1px solid var(--notion-border); color: var(--notion-text-main); margin-right: 4px;">Duyệt lại</button>
            <button class="notion-btn btn-delete" data-id="${kiosk.id}" style="padding: 3px 8px; font-size: 11.5px; background-color: #ff4d4f; color: #fff; border: none;"><i class="ph-light ph-trash"></i></button>
          `;
        }

        const dateStr = new Date(kiosk.created_at).toLocaleString('vi-VN');

        return `
          <tr>
            <td style="padding: 12px; font-weight: 600; color: var(--notion-text-main);">${kiosk.email}</td>
            <td><code class="notion-slug-tag">${kiosk.kios_name}</code></td>
            <td>
              <a href="${kiosk.channel}" target="_blank" class="kiosk-channel-link" style="color: var(--doca-forest); text-decoration: underline; font-size: 12px; word-break: break-all;">
                ${kiosk.channel}
              </a>
            </td>
            <td>${statusTag}</td>
            <td style="text-align: right; padding-right: 16px; white-space: nowrap;">
              ${actionButtons}
            </td>
          </tr>
        `;
      }).join('');

      // Gắn sự kiện cho các nút hành động
      setupActionListeners();
    }

    function setupActionListeners() {
      // 1. Phê duyệt
      kiosksTableBody.querySelectorAll('.btn-approve').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-id');
          if (confirm('Phê duyệt Kiosk này cho người dùng?')) {
            const { error } = await supabase
              .from('creator_kiosks')
              .update({ status: 'approved', rejection_reason: null, updated_at: new Date().toISOString() })
              .eq('id', id);

            if (error) {
              window.showToast('Lỗi: ' + error.message);
            } else {
              window.showToast('Đã phê duyệt Kiosk thành công! 🎉');
              loadKiosks();
            }
          }
        });
      });

      // 2. Kích hoạt Modal từ chối
      kiosksTableBody.querySelectorAll('.btn-reject-trigger').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          if (rejectKioskIdInput && rejectReasonInput && rejectModal) {
            rejectKioskIdInput.value = id;
            rejectReasonInput.value = '';
            rejectModal.classList.remove('hidden');
          }
        });
      });

      // 3. Chuyển về Chờ duyệt
      kiosksTableBody.querySelectorAll('.btn-pending').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-id');
          if (confirm('Đưa Kiosk này về trạng thái chờ duyệt?')) {
            const { error } = await supabase
              .from('creator_kiosks')
              .update({ status: 'pending', rejection_reason: null, updated_at: new Date().toISOString() })
              .eq('id', id);

            if (error) {
              window.showToast('Lỗi: ' + error.message);
            } else {
              window.showToast('Đã chuyển trạng thái về Chờ duyệt 🐾');
              loadKiosks();
            }
          }
        });
      });

      // 4. Xóa Kiosk
      kiosksTableBody.querySelectorAll('.btn-delete').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-id');
          if (confirm('CẢNH BÁO: Xóa Kiosk này sẽ xóa toàn bộ các sản phẩm liên kết! Cô/chú có thực sự muốn xóa?')) {
            const { error } = await supabase
              .from('creator_kiosks')
              .delete()
              .eq('id', id);

            if (error) {
              window.showToast('Lỗi: ' + error.message);
            } else {
              window.showToast('Đã xóa dữ liệu Kiosk 🐾');
              loadKiosks();
            }
          }
        });
      });
    }

    // --- SỰ KIỆN CHO MODAL TỪ CHỐI ---
    function hideModal() {
      if (rejectModal) rejectModal.classList.add('hidden');
    }
    closeModalBtn?.addEventListener('click', hideModal);
    cancelRejectBtn?.addEventListener('click', hideModal);
    
    confirmRejectBtn?.addEventListener('click', async () => {
      const id = rejectKioskIdInput.value;
      const reason = rejectReasonInput.value.trim();

      if (!reason) {
        alert('Vui lòng nhập lý do từ chối.');
        return;
      }

      const { error } = await supabase
        .from('creator_kiosks')
        .update({
          status: 'rejected',
          rejection_reason: reason,
          updated_at: new Date().toISOString()
        })
        .eq('id', id);

      if (error) {
        window.showToast('Lỗi từ chối: ' + error.message);
      } else {
        window.showToast('Đã từ chối đơn đăng ký Kiosk 🐾');
        hideModal();
        loadKiosks();
      }
    });

    // --- SỰ KIỆN TÌM KIẾM VÀ TABS ---
    searchInput?.addEventListener('input', filterAndRender);

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilterStatus = btn.getAttribute('data-status');
        filterAndRender();
      });
    });

    // Load dữ liệu ban đầu
    loadKiosks();
  });
</script>

<style is:global>
  /* Tabs filter style */
  .notion-tab-btn {
    background: none;
    border: none;
    padding: 6px 12px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--notion-text-light);
    cursor: pointer;
    border-radius: var(--notion-radius);
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .notion-tab-btn:hover {
    background-color: var(--notion-hover-bg);
    color: var(--notion-text-main);
  }
  .notion-tab-btn.active {
    background-color: var(--notion-active-bg);
    color: var(--notion-text-main);
    font-weight: 600;
  }
  .tab-count-badge {
    background-color: rgba(21, 23, 15, 0.08);
    color: var(--notion-text-light);
    padding: 1px 6px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;
  }
  .notion-tab-btn.active .tab-count-badge {
    background-color: rgba(21, 23, 15, 0.15);
    color: var(--notion-text-main);
  }

  /* Tag status styling */
  .notion-tag.status-pending {
    background-color: #FFF2E6;
    color: #E67E22;
    border: 1px solid rgba(230, 126, 34, 0.15);
  }
  .notion-tag.status-approved {
    background-color: #F0F9EB;
    color: var(--doca-forest);
    border: 1px solid rgba(60, 94, 22, 0.15);
  }
  .notion-tag.status-rejected {
    background-color: #FFF2F2;
    color: #D32F2F;
    border: 1px solid rgba(211, 47, 47, 0.15);
  }

  /* Modal styling */
  .notion-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(21, 23, 15, 0.4);
    z-index: 1000;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .notion-modal.hidden {
    display: none !important;
  }
  .notion-modal-content {
    background-color: var(--notion-bg);
    border: 1px solid var(--notion-border);
    border-radius: 8px;
    width: 90%;
    max-width: 440px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    overflow: hidden;
    animation: modalFadeIn 0.25s ease-out;
  }
  @keyframes modalFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .notion-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    border-bottom: 1px solid var(--notion-border);
    background-color: var(--notion-bg-sidebar);
  }
  .notion-modal-header h3 {
    margin: 0;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--notion-text-main);
  }
  .notion-modal-close-btn {
    background: none;
    border: none;
    font-size: 20px;
    color: var(--notion-text-light);
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }
  .notion-modal-close-btn:hover {
    color: var(--notion-text-main);
  }
  .notion-modal-body {
    padding: 16px;
  }
  .notion-textarea {
    background-color: #fff;
    border: 1px solid var(--notion-border);
    border-radius: 4px;
    padding: 8px;
    color: var(--notion-text-main);
    outline: none;
    resize: vertical;
    transition: border-color 0.2s ease;
  }
  .notion-textarea:focus {
    border-color: var(--doca-sprout);
  }
  .notion-btn-secondary {
    background-color: var(--notion-bg-sidebar);
    border: 1px solid var(--notion-border);
    color: var(--notion-text-main);
  }
  .notion-btn-secondary:hover {
    background-color: var(--notion-hover-bg);
  }
  .notion-btn-danger {
    background-color: #ff4d4f;
    border: none;
    color: #fff;
  }
  .notion-btn-danger:hover {
    background-color: #ff7875;
  }
  .spin {
    animation: spin 1s linear infinite;
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>
