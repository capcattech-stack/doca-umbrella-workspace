---
import AdminLayout from '../../components/AdminLayout.astro';
---

<AdminLayout title="Tài Chính & Ví Cá | Doca Coin Hub">
  <div class="billing-page-container">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 16px;">
      <div>
        <h2 style="font-size: 18px; font-weight: 700; color: var(--notion-text-main); margin: 0 0 4px 0; display: flex; align-items: center; gap: 8px;">
          <i class="ph-light ph-book-open-text" style="color: var(--doca-forest);"></i> Sổ Cái Biến Động & Tra Cứu Ví
        </h2>
        <p style="font-size: 13px; color: var(--notion-text-light); margin: 0;">
          Tra cứu số dư ví từng khách hàng và nhật ký bất biến (Append-only) ghi nhận toàn bộ biến động Cá
        </p>
      </div>
      <div style="display: flex; gap: 8px;">
        <button id="btn-open-credit-modal" class="notion-btn notion-btn-primary">
          <i class="ph-light ph-plus-circle"></i> + Bù Cá / Điều Chỉnh Số Dư
        </button>
        <button id="btn-refresh-all" class="notion-btn">
          <i class="ph-light ph-arrows-clockwise"></i> Làm mới
        </button>
      </div>
    </div>

    <!-- VIEW TOGGLE TABS (SỔ CÁI vs DANH SÁCH VÍ KHÁCH HÀNG) -->
    <div style="display: flex; gap: 8px; margin-bottom: 20px; border-bottom: 1px solid var(--notion-border); padding-bottom: 12px;">
      <button id="tab-btn-ledger" class="notion-btn notion-btn-primary" style="font-size: 12.5px; padding: 6px 14px;">
        <i class="ph-light ph-list-dashes"></i> Nhật Ký Sổ Cái Toàn Hệ Thống
      </button>
      <button id="tab-btn-wallets" class="notion-btn" style="font-size: 12.5px; padding: 6px 14px;">
        <i class="ph-light ph-users"></i> Danh Sách Ví Người Dùng (Số Dư Hiện Tại)
      </button>
    </div>

    <!-- WALLET INSPECTOR CARD (HIỆN KHI TRA CỨU MỘT USER CỤ THỂ) -->
    <div id="wallet-inspector-card" style="display: none; background: #ffffff; border: 1.5px solid var(--doca-forest); border-radius: var(--notion-radius); padding: 18px; margin-bottom: 20px; box-shadow: 0 4px 16px rgba(118, 193, 35, 0.08); position: relative;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 12px;">
          <div style="width: 44px; height: 44px; border-radius: 50%; background: rgba(118, 193, 35, 0.15); display: flex; align-items: center; justify-content: center; color: var(--doca-forest); font-size: 22px;">
            <i class="ph-light ph-user-circle"></i>
          </div>
          <div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span id="insp-email" style="font-size: 15px; font-weight: 700; color: var(--notion-text-main);">sen@doca.pet</span>
              <span style="padding: 2px 6px; border-radius: 4px; font-size: 10.5px; font-weight: 600; background: rgba(118, 193, 35, 0.15); color: var(--doca-forest);">Ví Đang Hoạt Động</span>
            </div>
            <div style="font-size: 11px; color: var(--notion-text-light); margin-top: 2px;">
              Mã Ví: <code id="insp-wallet-id" style="font-family: 'Space Mono', monospace;">--</code>
            </div>
          </div>
        </div>

        <div style="display: flex; align-items: center; gap: 8px;">
          <button id="btn-quick-credit-user" class="notion-btn notion-btn-primary" style="font-size: 11.5px; padding: 4px 10px;">
            <i class="ph-light ph-plus"></i> Bù Cá Cho User Này
          </button>
          <button id="btn-close-inspector" class="notion-btn" style="font-size: 11.5px; padding: 4px 8px;" title="Đóng chế độ soi ví">
            <i class="ph-light ph-x"></i>
          </button>
        </div>
      </div>

      <!-- Inspector Stats Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; background: #f8f9fa; border-radius: 6px; padding: 12px 16px;">
        <div>
          <div style="font-size: 11px; color: var(--notion-text-light); font-weight: 600; text-transform: uppercase;">Số Dư Khả Dụng</div>
          <div id="insp-balance" style="font-size: 20px; font-weight: 800; color: var(--doca-forest); margin-top: 2px;">-- Cá</div>
        </div>
        <div>
          <div style="font-size: 11px; color: var(--notion-text-light); font-weight: 600; text-transform: uppercase;">Tổng Tiền Đã Nạp</div>
          <div id="insp-total-recharged" style="font-size: 16px; font-weight: 700; color: var(--notion-text-main); margin-top: 2px;">-- đ</div>
        </div>
        <div>
          <div style="font-size: 11px; color: var(--notion-text-light); font-weight: 600; text-transform: uppercase;">Tổng Cá Đã Tiêu</div>
          <div id="insp-total-spent" style="font-size: 16px; font-weight: 700; color: #c0392b; margin-top: 2px;">-- Cá</div>
        </div>
        <div>
          <div style="font-size: 11px; color: var(--notion-text-light); font-weight: 600; text-transform: uppercase;">Giao Dịch Gần Nhất</div>
          <div id="insp-last-txn" style="font-size: 12px; color: var(--notion-text-main); margin-top: 4px;">--</div>
        </div>
      </div>
    </div>

    <!-- VIEW 1: NHẬT KÝ SỔ CÁI CHI TIẾT -->
    <div id="view-ledger-container">
      <!-- Filter Bar -->
      <div style="display: flex; gap: 12px; margin-bottom: 16px; align-items: center; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <label style="font-size: 12px; font-weight: 600; color: var(--notion-text-light);">Loại bút toán:</label>
          <select id="filter-txn-type" class="notion-input" style="width: 170px; font-size: 12px; padding: 4px 8px;">
            <option value="">Tất cả bút toán</option>
            <option value="RECHARGE">RECHARGE (Nạp tiền)</option>
            <option value="SPEND">SPEND (Tiêu cá mở khóa)</option>
            <option value="MANUAL_CREDIT">MANUAL_CREDIT (Bù thủ công)</option>
            <option value="REWARD">REWARD (Thưởng nhiệm vụ)</option>
            <option value="REFUND">REFUND (Hoàn tiền)</option>
          </select>
        </div>

        <div style="margin-left: auto; display: flex; align-items: center; gap: 8px;">
          <div style="position: relative;">
            <input type="text" id="input-search-ledger" class="notion-input" placeholder="🔍 Tra cứu: Gõ email hoặc SĐT..." style="width: 300px; font-size: 12px; padding-left: 28px;" />
            <i class="ph-light ph-magnifying-glass" style="position: absolute; left: 8px; top: 8px; color: var(--notion-text-light);"></i>
          </div>
        </div>
      </div>

      <!-- Ledger Table -->
      <div class="notion-table-wrapper">
        <table class="notion-table">
          <thead>
            <tr>
              <th>Mã Bút Toán</th>
              <th>Khách Hàng</th>
              <th>Loại Giao Dịch</th>
              <th>Biến Động</th>
              <th>Số Dư (Trước → Sau)</th>
              <th>Lý Do / Vết Kiểm Toán</th>
              <th>Thời Gian</th>
            </tr>
          </thead>
          <tbody id="ledger-table-body">
            <tr>
              <td colspan="7" style="text-align: center; color: var(--notion-text-light); padding: 32px;">
                Đang tải nhật ký sổ cái...
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pagination Ledger -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px;">
        <span id="ledger-page-info" style="font-size: 12px; color: var(--notion-text-light);">Hiển thị 0 bút toán</span>
        <div style="display: flex; gap: 6px;">
          <button id="btn-prev-ledger" class="notion-btn" style="font-size: 11.5px; padding: 4px 10px;" disabled>
            <i class="ph-light ph-caret-left"></i> Trang trước
          </button>
          <button id="btn-next-ledger" class="notion-btn" style="font-size: 11.5px; padding: 4px 10px;" disabled>
            Trang sau <i class="ph-light ph-caret-right"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- VIEW 2: DANH SÁCH VÍ TẤT CẢ NGƯỜI DÙNG -->
    <div id="view-wallets-container" style="display: none;">
      <!-- Search Wallets -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <span style="font-size: 13px; color: var(--notion-text-light);">Danh sách tài khoản ví khách hàng và số dư Cá hiện tại trong hệ thống</span>
        <div style="position: relative;">
          <input type="text" id="input-search-wallets" class="notion-input" placeholder="🔍 Tìm ví theo email, sđt, mã ví..." style="width: 280px; font-size: 12px; padding-left: 28px;" />
          <i class="ph-light ph-magnifying-glass" style="position: absolute; left: 8px; top: 8px; color: var(--notion-text-light);"></i>
        </div>
      </div>

      <!-- Wallets Table -->
      <div class="notion-table-wrapper">
        <table class="notion-table">
          <thead>
            <tr>
              <th>Khách Hàng (Email / SĐT)</th>
              <th>Mã Ví</th>
              <th>Số Dư Khả Dụng</th>
              <th>Ngày Tạo Ví</th>
              <th>Cập Nhật Cuối</th>
              <th style="text-align: right;">Hành Động</th>
            </tr>
          </thead>
          <tbody id="wallets-table-body">
            <tr>
              <td colspan="6" style="text-align: center; color: var(--notion-text-light); padding: 32px;">
                Đang tải danh sách ví...
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pagination Wallets -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px;">
        <span id="wallets-page-info" style="font-size: 12px; color: var(--notion-text-light);">Hiển thị 0 ví</span>
        <div style="display: flex; gap: 6px;">
          <button id="btn-prev-wallets" class="notion-btn" style="font-size: 11.5px; padding: 4px 10px;" disabled>
            <i class="ph-light ph-caret-left"></i> Trang trước
          </button>
          <button id="btn-next-wallets" class="notion-btn" style="font-size: 11.5px; padding: 4px 10px;" disabled>
            Trang sau <i class="ph-light ph-caret-right"></i>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL BÙ CÁ THỦ CÔNG -->
  <div id="modal-manual-credit" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: #ffffff; border-radius: 8px; border: 1px solid var(--notion-border); width: 100%; max-width: 500px; padding: 24px; box-shadow: 0 12px 32px rgba(0,0,0,0.15);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: var(--notion-text-main);">+ Bù Cá / Điều Chỉnh Số Dư Vào Sổ Cái</h3>
        <button id="btn-close-credit-modal" style="background: none; border: none; font-size: 18px; cursor: pointer; color: var(--notion-text-light);"><i class="ph-light ph-x"></i></button>
      </div>

      <p style="font-size: 12px; color: var(--notion-text-light); margin-bottom: 16px;">
        Hành động này sẽ sinh một bút toán <code>MANUAL_CREDIT</code> bất biến vào Sổ cái và tăng số dư ví của khách hàng ngay lập tức.
      </p>

      <form id="form-manual-credit" style="display: flex; flex-direction: column; gap: 14px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 500; margin-bottom: 4px;">Email hoặc Số điện thoại Khách Hàng</label>
          <input type="text" id="manual-user-identifier" class="notion-input" placeholder="sen@doca.pet hoặc 0987654321" required />
        </div>
        <div>
          <label style="display: block; font-size: 12px; font-weight: 500; margin-bottom: 4px;">Số Cá Cần Cộng (Cá)</label>
          <input type="number" id="manual-coin-amount" class="notion-input" placeholder="VD: 50" min="1" required />
        </div>
        <div>
          <label style="display: block; font-size: 12px; font-weight: 500; margin-bottom: 4px;">Lý Do Kiểm Toán (Audit Reason bắt buộc)</label>
          <input type="text" id="manual-audit-reason" class="notion-input" placeholder="VD: Bù đơn hàng MoMo bị nghẽn ngày 20/08" required />
        </div>
        <div style="margin-top: 12px; display: flex; gap: 8px; justify-content: flex-end;">
          <button type="button" id="btn-cancel-credit" class="notion-btn">Hủy</button>
          <button type="submit" class="notion-btn notion-btn-primary"><i class="ph-light ph-check-circle"></i> Xác Nhận Ghi Sổ Cái</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const COIN_HUB_API = import.meta.env.PUBLIC_COIN_HUB_API_URL || 'https://coin-hub-406a.onrender.com';
    const ADMIN_API_KEY = 'doca_admin_secret_key_2026';

    const authHeaders = {
      'Content-Type': 'application/json',
      'x-api-key': ADMIN_API_KEY,
    };

    let currentLedgerPage = 1;
    let currentWalletsPage = 1;
    const limit = 20;
    let searchDebounceTimeout: any = null;
    let inspectedUserIdentifier = '';

    document.addEventListener('DOMContentLoaded', () => {
      // Tab switching: Ledger vs Wallets
      const tabBtnLedger = document.getElementById('tab-btn-ledger');
      const tabBtnWallets = document.getElementById('tab-btn-wallets');
      const viewLedger = document.getElementById('view-ledger-container');
      const viewWallets = document.getElementById('view-wallets-container');

      function switchView(isLedger: boolean) {
        if (isLedger) {
          tabBtnLedger?.classList.add('notion-btn-primary');
          tabBtnWallets?.classList.remove('notion-btn-primary');
          if (viewLedger) viewLedger.style.display = 'block';
          if (viewWallets) viewWallets.style.display = 'none';
          loadLedger();
        } else {
          tabBtnWallets?.classList.add('notion-btn-primary');
          tabBtnLedger?.classList.remove('notion-btn-primary');
          if (viewWallets) viewWallets.style.display = 'block';
          if (viewLedger) viewLedger.style.display = 'none';
          loadWallets();
        }
      }

      tabBtnLedger?.addEventListener('click', () => switchView(true));
      tabBtnWallets?.addEventListener('click', () => switchView(false));

      // Hàm Tra Cứu Ví (Inspect Wallet)
      async function inspectUserWallet(query: string) {
        const card = document.getElementById('wallet-inspector-card');
        if (!card) return;

        if (!query || query.length < 2) {
          card.style.display = 'none';
          inspectedUserIdentifier = '';
          return;
        }

        try {
          const res = await fetch(`${COIN_HUB_API}/api/v1/admin/wallets/inspect?identifier=${encodeURIComponent(query)}&tenant_id=doca`, { headers: authHeaders });
          if (res.ok) {
            const wallet = await res.json();
            if (wallet && wallet.wallet_id) {
              inspectedUserIdentifier = wallet.email || wallet.phone || wallet.user_id;

              const emailEl = document.getElementById('insp-email');
              const walletIdEl = document.getElementById('insp-wallet-id');
              const balanceEl = document.getElementById('insp-balance');
              const rechargedEl = document.getElementById('insp-total-recharged');
              const spentEl = document.getElementById('insp-total-spent');
              const lastTxnEl = document.getElementById('insp-last-txn');

              if (emailEl) emailEl.innerText = wallet.email || wallet.phone || 'Khách #' + wallet.user_id.slice(0, 8);
              if (walletIdEl) walletIdEl.innerText = wallet.wallet_id;
              if (balanceEl) balanceEl.innerText = wallet.balance.toLocaleString('vi-VN') + ' Cá';
              if (rechargedEl) rechargedEl.innerText = `${wallet.total_recharged_vnd.toLocaleString('vi-VN')} đ (${wallet.successful_orders_count} đơn)`;
              if (spentEl) spentEl.innerText = `${wallet.total_spent_coins.toLocaleString('vi-VN')} Cá`;
              if (lastTxnEl) lastTxnEl.innerText = wallet.last_transaction_at ? new Date(wallet.last_transaction_at).toLocaleString('vi-VN') : 'Chưa có';

              card.style.display = 'block';
              return;
            }
          }
          card.style.display = 'none';
        } catch (err) {
          card.style.display = 'none';
        }
      }

      // Đóng Card Tra Cứu
      document.getElementById('btn-close-inspector')?.addEventListener('click', () => {
        const card = document.getElementById('wallet-inspector-card');
        const inputSearch = document.getElementById('input-search-ledger') as HTMLInputElement;
        if (card) card.style.display = 'none';
        if (inputSearch) inputSearch.value = '';
        inspectedUserIdentifier = '';
        loadLedger();
      });

      // Nút Bù cá nhanh cho user đang soi
      document.getElementById('btn-quick-credit-user')?.addEventListener('click', () => {
        if (inspectedUserIdentifier) {
          const identifierInput = document.getElementById('manual-user-identifier') as HTMLInputElement;
          if (identifierInput) identifierInput.value = inspectedUserIdentifier;
          openCreditModal();
        }
      });

      // Load Danh Sách Ví (Wallets List)
      async function loadWallets() {
        const tbody = document.getElementById('wallets-table-body');
        if (!tbody) return;

        const search = (document.getElementById('input-search-wallets') as HTMLInputElement)?.value.trim() || '';

        try {
          const res = await fetch(`${COIN_HUB_API}/api/v1/admin/wallets?tenant_id=doca&page=${currentWalletsPage}&limit=${limit}${search ? '&search=' + encodeURIComponent(search) : ''}`, { headers: authHeaders });
          if (res.ok) {
            const data = await res.json();
            const items = data.items || [];

            if (items.length === 0) {
              tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 28px; color: var(--notion-text-light);">Chưa có ví khách hàng nào được tạo.</td></tr>';
              return;
            }

            tbody.innerHTML = items.map((w: any) => `
              <tr>
                <td>
                  <div style="font-weight: 600; color: var(--notion-text-main); font-size: 13px;">
                    ${w.email || w.phone || 'Khách vãng lai'}
                  </div>
                  <div style="font-size: 11px; color: var(--notion-text-light);">ID: <code>${w.user_id.slice(0, 8)}...</code></div>
                </td>
                <td><code style="font-family: 'Space Mono', monospace; font-size: 11px; background: rgba(0,0,0,0.04); padding: 2px 4px; border-radius: 3px;">${w.id.slice(0, 8)}...</code></td>
                <td>
                  <span style="font-size: 15px; font-weight: 800; color: var(--doca-forest);">
                    ${Number(w.balance).toLocaleString('vi-VN')} Cá
                  </span>
                </td>
                <td style="font-size: 11.5px; color: var(--notion-text-light);">${new Date(w.created_at).toLocaleDateString('vi-VN')}</td>
                <td style="font-size: 11.5px; color: var(--notion-text-light);">${new Date(w.updated_at).toLocaleString('vi-VN')}</td>
                <td style="text-align: right; white-space: nowrap;">
                  <button class="notion-btn btn-inspect-user-wallet" data-id="${w.email || w.phone || w.user_id}" style="font-size: 11px; padding: 3px 8px; margin-right: 4px;">
                    <i class="ph-light ph-eye"></i> Soi Ví & Sổ Cái
                  </button>
                  <button class="notion-btn btn-credit-user-wallet" data-id="${w.email || w.phone || w.user_id}" style="font-size: 11px; padding: 3px 8px;">
                    <i class="ph-light ph-plus"></i> Bù Cá
                  </button>
                </td>
              </tr>
            `).join('');

            const pageInfo = document.getElementById('wallets-page-info');
            if (pageInfo) pageInfo.innerText = `Trang ${currentWalletsPage} / Tổng ${data.total || items.length} ví`;

            // Gán sự kiện Soi Ví từ Bảng
            document.querySelectorAll('.btn-inspect-user-wallet').forEach(btn => {
              btn.addEventListener('click', (e) => {
                const target = e.currentTarget as HTMLElement;
                const userId = target.dataset.id;
                if (!userId) return;

                switchView(true); // chuyển sang tab Ledger
                const inputSearch = document.getElementById('input-search-ledger') as HTMLInputElement;
                if (inputSearch) inputSearch.value = userId;
                inspectUserWallet(userId);
                loadLedger();
              });
            });

            // Gán sự kiện Bù Cá từ Bảng
            document.querySelectorAll('.btn-credit-user-wallet').forEach(btn => {
              btn.addEventListener('click', (e) => {
                const target = e.currentTarget as HTMLElement;
                const userId = target.dataset.id;
                if (!userId) return;

                const inputId = document.getElementById('manual-user-identifier') as HTMLInputElement;
                if (inputId) inputId.value = userId;
                openCreditModal();
              });
            });
          }
        } catch (e) {
          tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 24px; color: #d32f2f;">Chưa kết nối được Backend Coin Hub (:3005).</td></tr>';
        }
      }

      // Load Nhật Ký Sổ Cái (Ledger List)
      async function loadLedger() {
        const tbody = document.getElementById('ledger-table-body');
        if (!tbody) return;

        const typeFilter = (document.getElementById('filter-txn-type') as HTMLSelectElement)?.value || '';
        const search = (document.getElementById('input-search-ledger') as HTMLInputElement)?.value.trim().toLowerCase() || '';

        try {
          const res = await fetch(`${COIN_HUB_API}/api/v1/admin/transactions?tenant_id=doca&page=${currentLedgerPage}&limit=${limit}`, { headers: authHeaders });
          if (res.ok) {
            const data = await res.json();
            let items = data.items || [];

            // Filter by transaction type
            if (typeFilter) {
              items = items.filter((t: any) => t.type === typeFilter);
            }

            // Client-side search filter
            if (search) {
              items = items.filter((t: any) => 
                (t.id && t.id.toLowerCase().includes(search)) ||
                (t.wallet?.user?.email && t.wallet.user.email.toLowerCase().includes(search)) ||
                (t.wallet?.user?.phone && t.wallet.user.phone.includes(search)) ||
                (t.metadata?.audit_reason && t.metadata.audit_reason.toLowerCase().includes(search))
              );
            }

            if (items.length === 0) {
              tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 28px; color: var(--notion-text-light);">Chưa có bút toán nào ghi nhận trên Sổ cái.</td></tr>';
              return;
            }

            tbody.innerHTML = items.map((t: any) => {
              const amountNum = Number(t.amount);
              const isPositive = amountNum >= 0 && t.type !== 'SPEND';
              
              let typeBadgeStyle = 'background: rgba(21, 23, 15, 0.08); color: var(--notion-text-main);';
              if (t.type === 'RECHARGE') {
                typeBadgeStyle = 'background: rgba(118, 193, 35, 0.15); color: var(--doca-forest); font-weight: 600;';
              } else if (t.type === 'SPEND') {
                typeBadgeStyle = 'background: rgba(231, 76, 60, 0.12); color: #c0392b; font-weight: 600;';
              } else if (t.type === 'MANUAL_CREDIT') {
                typeBadgeStyle = 'background: rgba(52, 152, 219, 0.15); color: #2980b9; font-weight: 600;';
              } else if (t.type === 'REWARD') {
                typeBadgeStyle = 'background: rgba(241, 196, 15, 0.18); color: #d68910; font-weight: 600;';
              }

              const reason = t.metadata?.audit_reason || (t.type === 'RECHARGE' ? `Nạp tiền đơn #${(t.sourceRef || '').slice(0, 8)}` : (t.type === 'SPEND' ? `Tiêu mở khóa #${(t.sourceRef || '').slice(0, 8)}` : '--'));

              return `
                <tr>
                  <td><code style="font-family: 'Space Mono', monospace; font-size: 11px; background: rgba(0,0,0,0.04); padding: 2px 4px; border-radius: 3px;">${t.id.slice(0, 8)}...</code></td>
                  <td>
                    <div style="font-weight: 500;">${t.wallet?.user?.email || t.wallet?.user?.phone || 'Khách #' + (t.wallet?.userId || '').slice(0, 6)}</div>
                  </td>
                  <td>
                    <span style="padding: 2px 8px; border-radius: 12px; font-size: 11px; ${typeBadgeStyle}">
                      ${t.type}
                    </span>
                  </td>
                  <td>
                    <span style="font-weight: 700; color: ${isPositive ? 'var(--doca-forest)' : '#c0392b'};">
                      ${isPositive ? '+' : ''}${amountNum.toLocaleString('vi-VN')} Cá
                    </span>
                  </td>
                  <td style="font-size: 12px; color: var(--notion-text-light);">
                    ${Number(t.balanceBefore || 0).toLocaleString('vi-VN')} → <b style="color: var(--notion-text-main);">${Number(t.balanceAfter || 0).toLocaleString('vi-VN')}</b>
                  </td>
                  <td style="font-size: 12px; color: var(--notion-text-main); max-width: 250px;">
                    ${reason}
                  </td>
                  <td style="font-size: 11.5px; color: var(--notion-text-light);">${new Date(t.createdAt).toLocaleString('vi-VN')}</td>
                </tr>
              `;
            }).join('');

            const pageInfo = document.getElementById('ledger-page-info');
            if (pageInfo) pageInfo.innerText = `Trang ${currentLedgerPage} / Tổng ${data.total || items.length} bút toán`;
          }
        } catch (e) {
          tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 24px; color: #d32f2f;">Chưa kết nối được Backend Coin Hub (:3005).</td></tr>';
        }
      }

      // Modal Bù Cá
      const modalCredit = document.getElementById('modal-manual-credit');
      const btnOpenCredit = document.getElementById('btn-open-credit-modal');
      const btnCloseCredit = document.getElementById('btn-close-credit-modal');
      const btnCancelCredit = document.getElementById('btn-cancel-credit');
      const formCredit = document.getElementById('form-manual-credit');

      function openCreditModal() {
        if (modalCredit) modalCredit.style.display = 'flex';
      }
      function closeCreditModal() {
        if (modalCredit) modalCredit.style.display = 'none';
        (formCredit as HTMLFormElement)?.reset();
      }

      btnOpenCredit?.addEventListener('click', openCreditModal);
      btnCloseCredit?.addEventListener('click', closeCreditModal);
      btnCancelCredit?.addEventListener('click', closeCreditModal);

      formCredit?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const identifier = (document.getElementById('manual-user-identifier') as HTMLInputElement).value.trim();
        const amount = Number((document.getElementById('manual-coin-amount') as HTMLInputElement).value);
        const reason = (document.getElementById('manual-audit-reason') as HTMLInputElement).value.trim();

        const payload = {
          tenant_id: 'doca',
          amount,
          audit_reason: reason,
          ...(identifier.includes('@') ? { email: identifier } : { phone: identifier }),
        };

        try {
          const res = await fetch(`${COIN_HUB_API}/api/v1/admin/wallets/manual-credit`, {
            method: 'POST',
            headers: authHeaders,
            body: JSON.stringify(payload),
          });
          const result = await res.json();
          if (res.ok) {
            alert(`Đã ghi nhận bút toán thành công! Cộng ${amount} Cá vào ví. Số dư mới: ${result.new_balance} Cá`);
            closeCreditModal();
            loadLedger();
            loadWallets();
            if (inspectedUserIdentifier) {
              inspectUserWallet(inspectedUserIdentifier);
            }
          } else {
            alert('Lỗi: ' + (result.message || 'Không thể ghi bút toán'));
          }
        } catch (err: any) {
          alert('Không thể kết nối Backend Coin Hub: ' + err.message);
        }
      });

      document.getElementById('btn-refresh-all')?.addEventListener('click', () => {
        loadLedger();
        loadWallets();
        if (inspectedUserIdentifier) inspectUserWallet(inspectedUserIdentifier);
      });

      document.getElementById('filter-txn-type')?.addEventListener('change', () => {
        currentLedgerPage = 1;
        loadLedger();
      });

      // Lắng nghe tìm kiếm Ledger -> Gọi inspectUserWallet và loadLedger
      document.getElementById('input-search-ledger')?.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.trim();
        loadLedger();

        clearTimeout(searchDebounceTimeout);
        searchDebounceTimeout = setTimeout(() => {
          inspectUserWallet(query);
        }, 250);
      });

      // Lắng nghe tìm kiếm Wallets List
      document.getElementById('input-search-wallets')?.addEventListener('input', () => {
        currentWalletsPage = 1;
        clearTimeout(searchDebounceTimeout);
        searchDebounceTimeout = setTimeout(() => {
          loadWallets();
        }, 250);
      });

      loadLedger();
    });
  </script>
</AdminLayout>
