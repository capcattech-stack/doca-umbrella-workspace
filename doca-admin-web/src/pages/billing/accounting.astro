---
import AdminLayout from '../../components/AdminLayout.astro';
---

<AdminLayout title="Tài Chính & Ví Cá | Doca Coin Hub">
  <div class="billing-page-container">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
      <div>
        <h2 style="font-size: 18px; font-weight: 700; color: var(--notion-text-main); margin: 0 0 4px 0; display: flex; align-items: center; gap: 8px;">
          <i class="ph-light ph-chart-line-up" style="color: var(--doca-forest);"></i> Kế Toán, Dòng Tiền & Báo Cáo Thuế
        </h2>
        <p style="font-size: 13px; color: var(--notion-text-light); margin: 0;">
          Tổng hợp doanh thu gộp (Gross), ước tính phí cổng ZaloPay/MoMo, doanh thu thực nhận (Net) & Bảng kê xuất hóa đơn điện tử tổng (TT 78/2021/TT-BTC)
        </p>
      </div>
      <div style="display: flex; gap: 8px;">
        <button id="btn-export-csv" class="notion-btn notion-btn-primary">
          <i class="ph-light ph-download-simple"></i> Xuất Bảng Kê Excel/CSV
        </button>
        <button id="btn-refresh-accounting" class="notion-btn">
          <i class="ph-light ph-arrows-clockwise"></i> Làm mới
        </button>
      </div>
    </div>

    <!-- Financial Stats Bar -->
    <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px;">
      <div class="stat-card" style="background: #ffffff; border: 1px solid var(--notion-border); border-radius: var(--notion-radius); padding: 16px;">
        <div style="font-size: 12px; color: var(--notion-text-light); margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
          <i class="ph-light ph-wallet" style="font-size: 16px; color: var(--notion-text-main);"></i> DOANH THU GỘP (GROSS)
        </div>
        <div id="stat-gross-rev" style="font-size: 20px; font-weight: 700; color: var(--notion-text-main);">-- đ</div>
      </div>

      <div class="stat-card" style="background: #ffffff; border: 1px solid var(--notion-border); border-radius: var(--notion-radius); padding: 16px;">
        <div style="font-size: 12px; color: var(--notion-text-light); margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
          <i class="ph-light ph-percent" style="font-size: 16px; color: #e74c3c;"></i> PHÍ CỔNG ƯỚC TÍNH (~1.65%)
        </div>
        <div id="stat-gateway-fee" style="font-size: 20px; font-weight: 700; color: #e74c3c;">-- đ</div>
      </div>

      <div class="stat-card" style="background: #ffffff; border: 1px solid var(--notion-border); border-radius: var(--notion-radius); padding: 16px; border-left: 3px solid var(--doca-forest);">
        <div style="font-size: 12px; color: var(--notion-text-light); margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
          <i class="ph-light ph-bank" style="font-size: 16px; color: var(--doca-forest);"></i> THỰC NHẬN VỀ TK (NET SETTLEMENT)
        </div>
        <div id="stat-net-rev" style="font-size: 20px; font-weight: 700; color: var(--doca-forest);">-- đ</div>
      </div>

      <div class="stat-card" style="background: #ffffff; border: 1px solid var(--notion-border); border-radius: var(--notion-radius); padding: 16px;">
        <div style="font-size: 12px; color: var(--notion-text-light); margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
          <i class="ph-light ph-fish" style="font-size: 16px; color: #ff9900;"></i> TỔNG CÁ ĐÃ PHÁT HÀNH
        </div>
        <div id="stat-coins-issued" style="font-size: 20px; font-weight: 700; color: var(--notion-text-main);">-- Cá</div>
      </div>
    </div>

    <!-- Section: Daily Breakdown Table -->
    <div style="margin-bottom: 32px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <h2 style="font-size: 15px; font-weight: 600; color: var(--notion-text-main); margin: 0;">
          Bảng Kê Quyết Toán Doanh Thu Theo Ngày (Daily Reconciliation)
        </h2>
        <span style="font-size: 12px; color: var(--notion-text-light);">Căn cứ lập hóa đơn điện tử tổng cuối ngày</span>
      </div>

      <div class="notion-table-wrapper">
        <table class="notion-table">
          <thead>
            <tr>
              <th>Ngày Quyết Toán</th>
              <th>Số Đơn Thành Công</th>
              <th>Doanh Thu Gộp (Gross)</th>
              <th>Phí Cổng (~1.65%)</th>
              <th>Doanh Thu Thực Nhận (Net)</th>
              <th>Số Cá Cấp Ra</th>
              <th>Chi Tiết Cổng</th>
            </tr>
          </thead>
          <tbody id="daily-table-body">
            <tr>
              <td colspan="7" style="text-align: center; color: var(--notion-text-light); padding: 24px;">
                Đang tổng hợp số liệu kế toán...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Section: Detailed Orders -->
    <div>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <h2 style="font-size: 15px; font-weight: 600; color: var(--notion-text-main); margin: 0;">
          Bảng Kê Chi Tiết Từng Giao Dịch Thành Công (Audit Transactions)
        </h2>
      </div>

      <div class="notion-table-wrapper">
        <table class="notion-table">
          <thead>
            <tr>
              <th>Mã Đơn Hàng</th>
              <th>Khách Hàng</th>
              <th>Gói Nạp</th>
              <th>Cổng TT</th>
              <th>Mã GD Cổng</th>
              <th>Số Tiền Nạp</th>
              <th>Phí Cổng</th>
              <th>Thực Nhận</th>
              <th>Thời Gian</th>
            </tr>
          </thead>
          <tbody id="orders-detail-table-body">
            <tr>
              <td colspan="9" style="text-align: center; color: var(--notion-text-light); padding: 24px;">
                Đang tải chi tiết đơn hàng...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    const COIN_HUB_API = 'http://localhost:3005';
    const ADMIN_API_KEY = 'doca_admin_secret_key_2026';

    const authHeaders = {
      'Content-Type': 'application/json',
      'x-api-key': ADMIN_API_KEY,
    };

    let cachedReportData: any = null;

    document.addEventListener('DOMContentLoaded', () => {
      async function loadAccounting() {
        const dailyBody = document.getElementById('daily-table-body');
        const detailBody = document.getElementById('orders-detail-table-body');

        try {
          const res = await fetch(`${COIN_HUB_API}/api/v1/admin/accounting/report?tenant_id=doca`, { headers: authHeaders });
          if (res.ok) {
            const data = await res.json();
            cachedReportData = data;

            // Summary cards
            const statGross = document.getElementById('stat-gross-rev');
            const statFee = document.getElementById('stat-gateway-fee');
            const statNet = document.getElementById('stat-net-rev');
            const statCoins = document.getElementById('stat-coins-issued');

            if (statGross) statGross.innerText = (data.summary?.gross_revenue_vnd || 0).toLocaleString('vi-VN') + ' đ';
            if (statFee) statFee.innerText = '-' + (data.summary?.estimated_gateway_fee_vnd || 0).toLocaleString('vi-VN') + ' đ';
            if (statNet) statNet.innerText = (data.summary?.net_revenue_vnd || 0).toLocaleString('vi-VN') + ' đ';
            if (statCoins) statCoins.innerText = (data.summary?.total_coins_issued || 0).toLocaleString('vi-VN') + ' Cá';

            // Daily breakdown
            if (dailyBody) {
              const daily = data.daily_breakdown || [];
              if (daily.length === 0) {
                dailyBody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: var(--notion-text-light); padding: 24px;">Chưa phát sinh doanh thu quyết toán.</td></tr>';
              } else {
                dailyBody.innerHTML = daily.map((row: any) => {
                  const gatewayStr = Object.entries(row.gateways || {}).map(([gw, val]) => `${gw}: ${Number(val).toLocaleString('vi-VN')} đ`).join(', ');
                  return `
                    <tr>
                      <td><b>${row.date}</b></td>
                      <td><b>${row.orderCount}</b> đơn</td>
                      <td><b>${row.grossRevenue.toLocaleString('vi-VN')} đ</b></td>
                      <td style="color: #e74c3c;">-${row.gatewayFee.toLocaleString('vi-VN')} đ</td>
                      <td><b style="color: var(--doca-forest);">${row.netRevenue.toLocaleString('vi-VN')} đ</b></td>
                      <td><span style="color: var(--doca-forest); font-weight: 600;">+${row.coinsIssued.toLocaleString('vi-VN')} Cá</span></td>
                      <td style="font-size: 11.5px; color: var(--notion-text-light);">${gatewayStr || '--'}</td>
                    </tr>
                  `;
                }).join('');
              }
            }

            // Orders Detail Table
            if (detailBody) {
              const details = data.orders_detail || [];
              if (details.length === 0) {
                detailBody.innerHTML = '<tr><td colspan="9" style="text-align: center; color: var(--notion-text-light); padding: 24px;">Không có dữ liệu giao dịch thành công.</td></tr>';
              } else {
                detailBody.innerHTML = details.map((o: any) => `
                  <tr>
                    <td><code style="font-family: 'Space Mono', monospace; font-size: 11px; background: rgba(0,0,0,0.04); padding: 2px 4px; border-radius: 3px;">${o.id.slice(0, 8)}...</code></td>
                    <td><b>${o.user_identifier}</b></td>
                    <td>${o.package_name}</td>
                    <td><span style="padding: 2px 6px; border-radius: 4px; font-size: 11px; background: rgba(21,23,15,0.06); font-weight: 600;">${o.gateway}</span></td>
                    <td style="font-size: 11px; color: var(--notion-text-light);">${o.gateway_trans_id || '--'}</td>
                    <td><b>${o.amount_vnd.toLocaleString('vi-VN')} đ</b></td>
                    <td style="color: #e74c3c;">-${o.estimated_fee_vnd.toLocaleString('vi-VN')} đ</td>
                    <td><b style="color: var(--doca-forest);">${o.net_vnd.toLocaleString('vi-VN')} đ</b></td>
                    <td style="font-size: 11.5px; color: var(--notion-text-light);">${new Date(o.created_at).toLocaleString('vi-VN')}</td>
                  </tr>
                `).join('');
              }
            }
          }
        } catch (e) {
          if (dailyBody) dailyBody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: #d32f2f; padding: 24px;">Chưa kết nối được Backend Coin Hub (:3005).</td></tr>';
        }
      }

      // Export CSV (Excel Compatible with UTF-8 BOM)
      document.getElementById('btn-export-csv')?.addEventListener('click', () => {
        if (!cachedReportData || !cachedReportData.orders_detail || cachedReportData.orders_detail.length === 0) {
          alert('Không có dữ liệu đơn hàng để xuất file.');
          return;
        }

        const headers = ['Mã Đơn Hàng', 'Thời Gian', 'Khách Hàng', 'Gói Nạp', 'Cổng Thanh Toán', 'Mã GD Cổng', 'Doanh Thu Gộp (VNĐ)', 'Phí Cổng Ước Tính (VNĐ)', 'Thực Nhận (VNĐ)', 'Số Cá Cấp'];
        
        const rows = cachedReportData.orders_detail.map((o: any) => [
          `"${o.id}"`,
          `"${new Date(o.created_at).toLocaleString('vi-VN')}"`,
          `"${o.user_identifier}"`,
          `"${o.package_name}"`,
          `"${o.gateway}"`,
          `"${o.gateway_trans_id || ''}"`,
          o.amount_vnd,
          o.estimated_fee_vnd,
          o.net_vnd,
          o.coin_amount,
        ]);

        const csvContent = '\uFEFF' + [headers.join(','), ...rows.map((e: any[]) => e.join(','))].join('\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.setAttribute('href', url);
        link.setAttribute('download', `Bang_Ke_Doanh_Thu_Doca_${new Date().toISOString().split('T')[0]}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      });

      document.getElementById('btn-refresh-accounting')?.addEventListener('click', () => {
        loadAccounting();
      });

      loadAccounting();
    });
  </script>
</AdminLayout>
