---
import AdminLayout from '../../components/AdminLayout.astro';
---

<AdminLayout title="Tài Chính & Ví Cá | Doca Coin Hub">
  <div class="billing-page-container">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
      <div>
        <h2 style="font-size: 18px; font-weight: 700; color: var(--notion-text-main); margin: 0 0 4px 0; display: flex; align-items: center; gap: 8px;">
          <i class="ph-light ph-package" style="color: var(--doca-forest);"></i> Cấu Hình Bảng Giá & Gói Cá
        </h2>
        <p style="font-size: 13px; color: var(--notion-text-light); margin: 0;">
          Quản lý danh mục gói nạp, % khuyến mại thưởng thêm, thứ tự hiển thị và trạng thái mở bán
        </p>
      </div>
      <div style="display: flex; gap: 8px;">
        <button id="btn-add-package" class="notion-btn notion-btn-primary">
          <i class="ph-light ph-plus"></i> Thêm Gói Cá Mới
        </button>
      </div>
    </div>

    <!-- Packages Table -->
    <div class="notion-table-wrapper">
      <table class="notion-table">
        <thead>
          <tr>
            <th>Thứ Tự</th>
            <th>Tên Gói</th>
            <th>Giá VNĐ</th>
            <th>Số Cá Nhận</th>
            <th>% Khuyến Mại</th>
            <th>Trạng Thái</th>
            <th style="text-align: right;">Hành Động</th>
          </tr>
        </thead>
        <tbody id="packages-table-body">
          <tr>
            <td colspan="7" style="text-align: center; color: var(--notion-text-light); padding: 32px;">
              Đang tải danh sách gói cá...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- MODAL THÊM GÓI CÁ MỚI -->
  <div id="modal-add-package" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: #ffffff; border-radius: 8px; border: 1px solid var(--notion-border); width: 100%; max-width: 480px; padding: 24px; box-shadow: 0 12px 32px rgba(0,0,0,0.15);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: var(--notion-text-main);">Tạo Gói Nạp Cá Mới</h3>
        <button id="btn-close-package-modal" style="background: none; border: none; font-size: 18px; cursor: pointer; color: var(--notion-text-light);"><i class="ph-light ph-x"></i></button>
      </div>

      <form id="form-create-package" style="display: flex; flex-direction: column; gap: 12px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 500; margin-bottom: 4px;">Tên Gói</label>
          <input type="text" id="pkg-name" class="notion-input" placeholder="VD: Gói Cá Hồi Vàng" required />
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="display: block; font-size: 12px; font-weight: 500; margin-bottom: 4px;">Giá VNĐ</label>
            <input type="number" id="pkg-amount-vnd" class="notion-input" placeholder="50000" min="1000" step="1000" required />
          </div>
          <div>
            <label style="display: block; font-size: 12px; font-weight: 500; margin-bottom: 4px;">Số Cá Nhận</label>
            <input type="number" id="pkg-coin-amount" class="notion-input" placeholder="550" min="1" required />
          </div>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="display: block; font-size: 12px; font-weight: 500; margin-bottom: 4px;">% Thưởng Khuyến Mại</label>
            <input type="number" id="pkg-bonus" class="notion-input" placeholder="10" min="0" max="100" value="0" />
          </div>
          <div>
            <label style="display: block; font-size: 12px; font-weight: 500; margin-bottom: 4px;">Thứ Tự Hiển Thị</label>
            <input type="number" id="pkg-sort" class="notion-input" placeholder="1" min="0" value="0" />
          </div>
        </div>
        <div style="margin-top: 12px; display: flex; gap: 8px; justify-content: flex-end;">
          <button type="button" id="btn-cancel-package" class="notion-btn">Hủy</button>
          <button type="submit" class="notion-btn notion-btn-primary"><i class="ph-light ph-check"></i> Lưu Gói Mới</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL CHỈNH SỬA GÓI CÁ -->
  <div id="modal-edit-package" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: #ffffff; border-radius: 8px; border: 1px solid var(--notion-border); width: 100%; max-width: 480px; padding: 24px; box-shadow: 0 12px 32px rgba(0,0,0,0.15);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: var(--notion-text-main);">Chỉnh Sửa Gói Cá</h3>
        <button id="btn-close-edit-modal" style="background: none; border: none; font-size: 18px; cursor: pointer; color: var(--notion-text-light);"><i class="ph-light ph-x"></i></button>
      </div>

      <form id="form-edit-package" style="display: flex; flex-direction: column; gap: 12px;">
        <input type="hidden" id="edit-pkg-id" />
        <div>
          <label style="display: block; font-size: 12px; font-weight: 500; margin-bottom: 4px;">Tên Gói</label>
          <input type="text" id="edit-pkg-name" class="notion-input" required />
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="display: block; font-size: 12px; font-weight: 500; margin-bottom: 4px;">Giá VNĐ</label>
            <input type="number" id="edit-pkg-amount-vnd" class="notion-input" min="1000" step="1000" required />
          </div>
          <div>
            <label style="display: block; font-size: 12px; font-weight: 500; margin-bottom: 4px;">Số Cá Nhận</label>
            <input type="number" id="edit-pkg-coin-amount" class="notion-input" min="1" required />
          </div>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="display: block; font-size: 12px; font-weight: 500; margin-bottom: 4px;">% Thưởng Khuyến Mại</label>
            <input type="number" id="edit-pkg-bonus" class="notion-input" min="0" max="100" />
          </div>
          <div>
            <label style="display: block; font-size: 12px; font-weight: 500; margin-bottom: 4px;">Thứ Tự Hiển Thị</label>
            <input type="number" id="edit-pkg-sort" class="notion-input" min="0" />
          </div>
        </div>
        <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px;">
          <input type="checkbox" id="edit-pkg-active" style="cursor: pointer;" />
          <label for="edit-pkg-active" style="font-size: 12.5px; cursor: pointer; user-select: none;">Đang kích hoạt bán cho người dùng</label>
        </div>
        <div style="margin-top: 12px; display: flex; gap: 8px; justify-content: flex-end;">
          <button type="button" id="btn-cancel-edit" class="notion-btn">Hủy</button>
          <button type="submit" class="notion-btn notion-btn-primary"><i class="ph-light ph-check"></i> Lưu Thay Đổi</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const COIN_HUB_API = import.meta.env.PUBLIC_COIN_HUB_API_URL || 'http://localhost:3005';
    const ADMIN_API_KEY = 'doca_admin_secret_key_2026';

    const authHeaders = {
      'Content-Type': 'application/json',
      'x-api-key': ADMIN_API_KEY,
    };

    document.addEventListener('DOMContentLoaded', () => {
      async function loadPackages() {
        const tbody = document.getElementById('packages-table-body');
        if (!tbody) return;
        try {
          const res = await fetch(`${COIN_HUB_API}/api/v1/admin/packages?tenant_id=doca`, { headers: authHeaders });
          if (res.ok) {
            const pkgs = await res.json();
            if (!pkgs || pkgs.length === 0) {
              tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: var(--notion-text-light); padding: 24px;">Chưa có gói nạp nào.</td></tr>';
              return;
            }
            tbody.innerHTML = pkgs.map((p: any) => `
              <tr>
                <td><b>#${p.sortOrder}</b></td>
                <td><b>${p.name}</b></td>
                <td>${Number(p.amountVnd).toLocaleString('vi-VN')} đ</td>
                <td><span style="color: var(--doca-forest); font-weight: 600;">+${Number(p.coinAmount)} Cá</span></td>
                <td>${p.bonusPercentage > 0 ? `<span style="color: #ff6600; font-weight: 600;">+${p.bonusPercentage}%</span>` : '0%'}</td>
                <td>
                  <span style="padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; background: ${p.isActive ? 'rgba(118, 193, 35, 0.15)' : 'rgba(21, 23, 15, 0.08)'}; color: ${p.isActive ? 'var(--doca-forest)' : 'var(--notion-text-disabled)'};">
                    ${p.isActive ? '● Đang Bán' : '○ Tắt Bán'}
                  </span>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                  <button class="notion-btn btn-toggle-pkg" data-id="${p.id}" data-active="${p.isActive}" style="font-size: 11px; padding: 3px 6px; margin-right: 4px;">
                    ${p.isActive ? '<i class="ph-light ph-pause"></i> Tắt' : '<i class="ph-light ph-play"></i> Bật'}
                  </button>
                  <button class="notion-btn btn-edit-pkg" data-pkg="${encodeURIComponent(JSON.stringify(p))}" style="font-size: 11px; padding: 3px 6px; margin-right: 4px;">
                    <i class="ph-light ph-pencil"></i> Sửa
                  </button>
                  <button class="notion-btn btn-delete-pkg" data-id="${p.id}" data-name="${p.name}" style="font-size: 11px; padding: 3px 6px; color: #d32f2f;">
                    <i class="ph-light ph-trash"></i>
                  </button>
                </td>
              </tr>
            `).join('');

            // Toggle Bật / Tắt Bán
            document.querySelectorAll('.btn-toggle-pkg').forEach(btn => {
              btn.addEventListener('click', async (e) => {
                const target = e.currentTarget as HTMLElement;
                const pkgId = target.dataset.id;
                const isCurrentlyActive = target.dataset.active === 'true';
                if (!pkgId) return;

                target.innerHTML = `<i class="ph-light ph-spinner spin"></i>`;
                (target as HTMLButtonElement).disabled = true;

                try {
                  const updateRes = await fetch(`${COIN_HUB_API}/api/v1/admin/packages/${pkgId}`, {
                    method: 'PUT',
                    headers: authHeaders,
                    body: JSON.stringify({ is_active: !isCurrentlyActive }),
                  });
                  if (updateRes.ok) {
                    loadPackages();
                  } else {
                    const err = await updateRes.json();
                    alert('Lỗi cập nhật: ' + (err.message || 'Không thể đổi trạng thái'));
                  }
                } catch (err: any) {
                  alert('Lỗi kết nối Coin Hub: ' + err.message);
                }
              });
            });

            // Mở Modal Sửa Gói
            document.querySelectorAll('.btn-edit-pkg').forEach(btn => {
              btn.addEventListener('click', (e) => {
                const target = e.currentTarget as HTMLElement;
                const pkgRaw = target.dataset.pkg;
                if (!pkgRaw) return;
                try {
                  const pkg = JSON.parse(decodeURIComponent(pkgRaw));
                  (document.getElementById('edit-pkg-id') as HTMLInputElement).value = pkg.id;
                  (document.getElementById('edit-pkg-name') as HTMLInputElement).value = pkg.name;
                  (document.getElementById('edit-pkg-amount-vnd') as HTMLInputElement).value = String(Number(pkg.amountVnd));
                  (document.getElementById('edit-pkg-coin-amount') as HTMLInputElement).value = String(Number(pkg.coinAmount));
                  (document.getElementById('edit-pkg-bonus') as HTMLInputElement).value = String(pkg.bonusPercentage || 0);
                  (document.getElementById('edit-pkg-sort') as HTMLInputElement).value = String(pkg.sortOrder || 0);
                  (document.getElementById('edit-pkg-active') as HTMLInputElement).checked = Boolean(pkg.isActive);

                  const modalEdit = document.getElementById('modal-edit-package');
                  if (modalEdit) modalEdit.style.display = 'flex';
                } catch (err) {
                  console.error('Error parsing pkg data:', err);
                }
              });
            });

            // Xóa Gói
            document.querySelectorAll('.btn-delete-pkg').forEach(btn => {
              btn.addEventListener('click', async (e) => {
                const target = e.currentTarget as HTMLElement;
                const pkgId = target.dataset.id;
                const pkgName = target.dataset.name;
                if (!pkgId) return;

                if (!confirm(`Bạn có chắc chắn muốn xóa gói "${pkgName}"?`)) return;

                try {
                  const delRes = await fetch(`${COIN_HUB_API}/api/v1/admin/packages/${pkgId}`, {
                    method: 'DELETE',
                    headers: authHeaders,
                  });
                  if (delRes.ok) {
                    alert(`Đã xóa gói "${pkgName}" thành công!`);
                    loadPackages();
                  } else {
                    const err = await delRes.json();
                    alert(err.message || 'Lỗi: Không thể xóa gói');
                  }
                } catch (err: any) {
                  alert('Lỗi kết nối Coin Hub: ' + err.message);
                }
              });
            });
          }
        } catch (e) {
          tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: #d32f2f;">Lỗi kết nối API Coin Hub.</td></tr>';
        }
      }

      // Modal Thêm Gói Mới
      const modalPkg = document.getElementById('modal-add-package');
      const btnAddPkg = document.getElementById('btn-add-package');
      const btnClosePkg = document.getElementById('btn-close-package-modal');
      const btnCancelPkg = document.getElementById('btn-cancel-package');
      const formCreatePkg = document.getElementById('form-create-package');

      function openPkgModal() {
        if (modalPkg) modalPkg.style.display = 'flex';
      }
      function closePkgModal() {
        if (modalPkg) modalPkg.style.display = 'none';
        (formCreatePkg as HTMLFormElement)?.reset();
      }

      btnAddPkg?.addEventListener('click', openPkgModal);
      btnClosePkg?.addEventListener('click', closePkgModal);
      btnCancelPkg?.addEventListener('click', closePkgModal);

      formCreatePkg?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = (document.getElementById('pkg-name') as HTMLInputElement).value.trim();
        const amount_vnd = Number((document.getElementById('pkg-amount-vnd') as HTMLInputElement).value);
        const coin_amount = Number((document.getElementById('pkg-coin-amount') as HTMLInputElement).value);
        const bonus_percentage = Number((document.getElementById('pkg-bonus') as HTMLInputElement).value || 0);
        const sort_order = Number((document.getElementById('pkg-sort') as HTMLInputElement).value || 0);

        const payload = {
          tenant_id: 'doca',
          name,
          amount_vnd,
          coin_amount,
          bonus_percentage,
          sort_order,
          is_active: true,
        };

        try {
          const res = await fetch(`${COIN_HUB_API}/api/v1/admin/packages`, {
            method: 'POST',
            headers: authHeaders,
            body: JSON.stringify(payload),
          });
          const result = await res.json();
          if (res.ok) {
            alert(`Đã thêm gói "${name}" thành công!`);
            closePkgModal();
            loadPackages();
          } else {
            alert('Lỗi tạo gói: ' + (result.message || 'Không thể tạo gói'));
          }
        } catch (err: any) {
          alert('Lỗi kết nối Backend Coin Hub: ' + err.message);
        }
      });

      // Modal Chỉnh Sửa Gói
      const modalEdit = document.getElementById('modal-edit-package');
      const btnCloseEdit = document.getElementById('btn-close-edit-modal');
      const btnCancelEdit = document.getElementById('btn-cancel-edit');
      const formEditPkg = document.getElementById('form-edit-package');

      function closeEditModal() {
        if (modalEdit) modalEdit.style.display = 'none';
        (formEditPkg as HTMLFormElement)?.reset();
      }

      btnCloseEdit?.addEventListener('click', closeEditModal);
      btnCancelEdit?.addEventListener('click', closeEditModal);

      formEditPkg?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = (document.getElementById('edit-pkg-id') as HTMLInputElement).value;
        const name = (document.getElementById('edit-pkg-name') as HTMLInputElement).value.trim();
        const amount_vnd = Number((document.getElementById('edit-pkg-amount-vnd') as HTMLInputElement).value);
        const coin_amount = Number((document.getElementById('edit-pkg-coin-amount') as HTMLInputElement).value);
        const bonus_percentage = Number((document.getElementById('edit-pkg-bonus') as HTMLInputElement).value || 0);
        const sort_order = Number((document.getElementById('edit-pkg-sort') as HTMLInputElement).value || 0);
        const is_active = (document.getElementById('edit-pkg-active') as HTMLInputElement).checked;

        const payload = {
          name,
          amount_vnd,
          coin_amount,
          bonus_percentage,
          sort_order,
          is_active,
        };

        try {
          const res = await fetch(`${COIN_HUB_API}/api/v1/admin/packages/${id}`, {
            method: 'PUT',
            headers: authHeaders,
            body: JSON.stringify(payload),
          });
          const result = await res.json();
          if (res.ok) {
            alert(`Đã cập nhật gói "${name}" thành công!`);
            closeEditModal();
            loadPackages();
          } else {
            alert('Lỗi cập nhật: ' + (result.message || 'Không thể cập nhật gói'));
          }
        } catch (err: any) {
          alert('Lỗi kết nối Backend Coin Hub: ' + err.message);
        }
      });

      loadPackages();
    });
  </script>
</AdminLayout>
