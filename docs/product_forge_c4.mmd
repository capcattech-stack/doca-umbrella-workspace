graph TD
    %% Actors
    User(("Business User<br/>(Người dùng ẩn danh)"))
    Admin(("Admin / PO<br/>(Quản trị viên)"))
    LLM["LLM Service<br/>(External APIs)"]

    subgraph "Product Forge System"
        WebApp["Web Application<br/>[Container: Next.js]<br/>Giao diện Chatbot & Kanban Board"]
        Orchestrator["AI Orchestrator Service<br/>[Container: Node.js / LangGraph]<br/>Điều phối Cố vấn Ảo & Ban Bệ"]
        DB[("Operational DB<br/>[Container: PostgreSQL]<br/>Lưu trữ Idea_ID, Chat Logs, PRDs")]
        VectorDB[("Knowledge Base<br/>[Container: Vector DB]<br/>Lưu trữ Kiến trúc hệ thống (RAG)")]
    end

    User -- "Submit Idea & Chat<br/>[HTTPS]" --> WebApp
    Admin -- "Quản lý Vòng đời & UAT<br/>[HTTPS]" --> WebApp
    
    WebApp -- "Routing messages<br/>[REST / WebSocket]" --> Orchestrator
    Orchestrator -- "Đọc/Ghi Trạng thái Chat & PRD<br/>[SQL]" --> DB
    Orchestrator -- "Truy vấn tính khả thi Kỹ thuật<br/>[HTTPS/gRPC]" --> VectorDB
    Orchestrator -- "Thực thi Market/Tech/Product Agents<br/>[HTTPS]" --> LLM

    classDef actor fill:#08427b,stroke:#052e56,color:#fff;
    classDef container fill:#438dd5,stroke:#2e6295,color:#fff;
    classDef database fill:#438dd5,stroke:#2e6295,color:#fff,shape:cylinder;
    classDef external fill:#999999,stroke:#666666,color:#fff;

    class User,Admin actor;
    class WebApp,Orchestrator container;
    class DB,VectorDB database;
    class LLM external;
