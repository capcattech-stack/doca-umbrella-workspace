graph TD
    %% Khai báo Style (Màu sắc)
    classDef user fill:#f9f9f9,stroke:#333,stroke-width:2px;
    classDef frontend fill:#d4edda,stroke:#28a745,stroke-width:2px;
    classDef agent fill:#cce5ff,stroke:#007bff,stroke-width:2px;
    classDef decision fill:#fff3cd,stroke:#ffc107,stroke-width:2px;
    classDef document fill:#e2e3e5,stroke:#383d41,stroke-width:2px;

    User([Business User]) -->|Nhập Ý Tưởng Thô| VA(Virtual Advisor<br/>Frontend)
    class User user;
    class VA frontend;

    VA -->|Text Routing| Sophia_Classify{Product Agent<br/>Phân loại Ý tưởng}
    class Sophia_Classify decision;

    %% Nhánh A: Tính năng Mới (P&L)
    subgraph "PATH A: P&L & Trade-off (Tính năng mới)"
        Sophia_Classify -->|Nhãn [NEW]| Market_A[Market Agent<br/>Chạy Mom Test / Ép Cam Kết Doanh thu]
        Market_A --> Tech_A[Tech Agent<br/>Quét RAG VectorDB -> Tính Cost/Effort]
        Tech_A --> Data_A[Data Agent<br/>Tổng hợp Báo cáo Mini P&L]
    end

    %% Nhánh B: Cải tiến (RICE Score)
    subgraph "PATH B: RICE Score (Cải tiến/Tối ưu)"
        Sophia_Classify -->|Nhãn [ENHANCE]| Data_B[Data Agent<br/>Đọc baseline_metrics.md -> Tính Reach]
        Data_B --> Market_B[Market Agent<br/>Thẩm định Bằng Chứng -> Phạt Confidence]
        Market_B --> Tech_B[Tech Agent<br/>Tính Effort Man-days]
    end

    %% Chốt hạ vòng lặp (Arbitration)
    Data_A --> Sophia_Arb
    Tech_B --> Sophia_Arb
    
    Sophia_Arb{Product Agent<br/>Đánh giá RICE/ROI<br/>Có đáng làm không?}
    class Sophia_Arb decision;

    Sophia_Arb -.->|ROI Âm / Data Mù Mờ| Reject[Yêu cầu User làm rõ / Cắt giảm Scope]
    Reject -.->|Vòng lặp| VA

    Sophia_Arb -->|Xứng đáng| Sizing{Product Agent<br/>Ma trận Output Sizing}
    class Sizing decision;

    %% Render Đầu ra
    Sizing -->|Size S < 3 ngày| Out_S[User Story + AC]
    Sizing -->|Size M 3-10 ngày| Out_M[Feature Brief + List US]
    Sizing -->|Size L/XL > 10 ngày| Out_L[Tài liệu PRD Hoàn chỉnh<br/>Tuân thủ PRD_Template.md]
    
    class Out_S,Out_M,Out_L document;

    %% Thực thi Hậu kiểm
    Out_S --> QA[QA Agent<br/>Auto-gen UAT Test-cases]
    Out_M --> QA
    Out_L --> QA
    
    class Market_A,Tech_A,Data_A,Data_B,Market_B,Tech_B,QA agent;
