  "termsTitle": "Privacy Policy",
  "termsHeroTitle": "Privacy Policy – Capcat 🐾",
  "termsIntro": "Capcat (\"we\") is committed to protecting your personal data and privacy when using the app. This policy explains how we collect, use, store, and protect your information.",
  "termsSection1Title": "1. Information we collect",
  "termsSection1Body": "When you use Capcat, we may collect:\\n  •  Account info: email, name, avatar, password.\\n  •  Pet info: name, age, species, photos.\\n  •  Interaction info: AI chat history, notes, journals or “Memory Box” you create.\\n  •  Device data: device type, OS, IP address (for technical and security purposes only).",
  "termsSection2Title": "2. How we use information",
  "termsSection2Body": "We use your data to:\\n  •  Provide and improve app features.\\n  •  Personalize experience (e.g., whisper suggestions, storytelling from photos/notes).\\n  •  Send notifications about pet activities, product or policy updates.\\n  •  Detect and prevent fraud, keep accounts secure.",
  "termsSection3Title": "3. Data sharing",
  "termsSection3Body": "We do NOT sell personal information to third parties. Data is only shared when:\\n  •  We have your consent.\\n  •  Required to comply with the law.\\n  •  Working with service providers (e.g., cloud storage) to operate the app.",
  "termsSection4Title": "4. Storage & Security",
  "termsSection4Body": "Data is stored on secure servers. Passwords are encrypted. We apply technical and organizational security measures to protect your data.",
  "termsSection5Title": "5. Your rights",
  "termsSection5Body": "You can:\\n  •  View, edit, or delete your profile info.\\n  •  Request to delete your account and all related data.\\n  •  Opt out of promotional notifications at any time.",
  "termsSection6Title": "6. Retention period",
  "termsSection6Body": "We keep your information while you use the app. If you stop using it, we will delete data within 30 days.",
  "termsSection7Title": "7. Data when signing in with Google",
  "termsSection7Body": "When you use “Sign in with Google”, we only access an anonymous email to create an account. We do not use Google data for marketing or sharing without individual consent.",
  "termsContact": "If you have questions or requests about privacy, please contact:",
  "termsContactEmail": "support@capcat.app"
}
