---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Capcat Kiosk - Điểm Chạm Tiếp Thị Của Bạn", 
	description = "Trang tiếp thị liên kết mộc mạc, đáng yêu và đầy tin cậy từ những nhà sáng tạo của gia đình Capcat."
} = Astro.props;

const googleAnalyticsId = import.meta.env.PUBLIC_GA_ID || 'G-0RCGZRPEGR';
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="https://capcat.vn/images/brand/symbol-green.png" />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Google Analytics (GA4) -->
		{googleAnalyticsId && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
				<script is:inline define:vars={{ googleAnalyticsId }}>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', googleAnalyticsId);
				</script>
			</>
		)}

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,400&family=Space+Mono:ital,wght@0,400;1,400&display=swap" rel="stylesheet">
		
		<!-- Phosphor Icons CDN -->
		<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css" />
		<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/light/style.css" />
		<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/thin/style.css" />
		<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/fill/style.css" />
		<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/duotone/style.css" />
	</head>
	<body>
		<slot />

		<!-- Footer -->
		<footer style="padding: 4rem 1.5rem 6rem; background-color: var(--cozy-bg-oatmeal); border-top: 1px solid var(--cozy-border-light); margin-top: 5rem; text-align: center;">
			<div class="container" style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
				<img src="https://capcat.vn/images/brand/logo-light.png" alt="Capcat Logo" style="height: 24px; opacity: 0.85;" onerror="this.style.display='none'" />
				<span class="whisper-mono" style="font-size: 0.78rem; color: var(--cozy-text-charcoal);">
					&copy; 2026 kiosk.capcat.vn · Được vận hành bởi DOCA & Các Boss 🐾
				</span>
			</div>
		</footer>
	</body>
</html>
