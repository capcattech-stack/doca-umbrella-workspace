---
import Layout from '../layouts/Layout.astro';

// Đọc thông tin kết nối Supabase từ biến môi trường
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---

<Layout title="Capcat Kiosk | Cửa Hàng Tiếp Thị Liên Kết 🐾">
  <!-- Global Navbar trên Kiosk -->
  <nav class="kiosk-global-navbar">
    <div class="navbar-container">
      <!-- Nút Hamburger bên trái (chỉ hiển thị trên Mobile) -->
      <button id="kiosk-hamburger-btn" class="kiosk-hamburger-btn" aria-label="Mở menu">
        <i class="ph-light ph-list"></i>
      </button>

      <!-- Logo text ở bên trái trên Desktop, và Logo symbol ở giữa trên Mobile -->
      <a href="https://doca.pet/" target="_blank" class="navbar-logo">
        <!-- Logo Text (Desktop) -->
        <span class="logo-text desktop-only">doca<span class="logo-dot">.</span>pet</span>
        <!-- Logo Symbol (Mobile) -->
        <img src="/images/brand/symbol-light.png" alt="Doca Logo" class="logo-symbol mobile-only" />
      </a>
      
      <!-- Menu Links (Desktop) -->
      <div class="navbar-links desktop-only">
        <a href="https://doca.pet/music" target="_blank" class="nav-link">Music</a>
        <a href="https://doca.pet/blog" target="_blank" class="nav-link">Blog</a>
      </div>
      
      <!-- Cổng Google Auth (Bên phải trên cả Mobile & Desktop) -->
      <div id="kiosk-nav-auth-container" class="kiosk-nav-auth-container">
        <!-- Tự động nạp bằng JS (Nút Google Auth hoặc Avatar) -->
      </div>
    </div>

    <!-- Dropdown Menu dưới dạng Panel trượt (chỉ hiển thị trên Mobile khi active) -->
    <div id="kiosk-mobile-menu" class="kiosk-mobile-menu">
      <a href="https://doca.pet/music" target="_blank" class="mobile-nav-link"><i class="ph-light ph-music-notes"></i> Music</a>
      <a href="https://doca.pet/blog" target="_blank" class="mobile-nav-link"><i class="ph-light ph-article"></i> Blog</a>
    </div>
  </nav>

  <!-- Truyền biến môi trường sang client-side -->
  <script is:inline define:vars={{ supabaseUrl, supabaseAnonKey }}>
    window.PUBLIC_SUPABASE_URL = supabaseUrl;
    window.PUBLIC_SUPABASE_ANON_KEY = supabaseAnonKey;
  </script>

  <!-- 1. GIAO DIỆN LANDING PAGE (ROOT ROUTE `/`) -->
  <div id="kiosk-landing-view" class="hidden">
    <main style="padding: 6rem 1.5rem; min-height: 70vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">
      <div class="container" style="max-width: 600px; display: flex; flex-direction: column; gap: 2rem; align-items: center;">
        <div style="font-size: 4.5rem; color: var(--cozy-accent-identity);"><i class="ph-light ph-storefront"></i></div>
        
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <h1 class="landing-title" style="color: var(--cozy-text-obsidian); font-weight: 800; line-height: 1.25;">Capcat Kiosk Platform</h1>
          <p class="whisper-mono" style="font-size: 0.9rem;">Không gian nhỏ xinh lưu trữ và giới thiệu những món đồ lành mạnh cho Boss.</p>
        </div>

        <div class="welcome-box" style="background-color: var(--cozy-bg-pure); border: 1px solid var(--cozy-border-light); border-radius: 16px; padding: 2rem; box-shadow: var(--cozy-shadow-default); width: 100%; text-align: left; position: relative;">
          <div style="position: absolute; top: 0; left: 0; width: 100%; height: 5px; background-color: var(--cozy-accent-identity); border-radius: 16px 16px 0 0;"></div>
          <h3 style="font-size: 1.15rem; font-weight: 600; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem; color: var(--cozy-text-obsidian);">
            <i class="ph-light ph-sparkles" style="color: var(--cozy-accent-identity);"></i> Boss muốn tự mở góc Kiosk xinh?
          </h3>
          <p style="font-size: 0.88rem; line-height: 1.6; color: var(--cozy-text-charcoal); margin-bottom: 1.25rem;">
            Nếu ba là nhà sáng tạo nội dung, blogger hoặc chủ nuôi thú cưng cá tính, ba có thể tự thiết lập một trang Kiosk cá nhân dạng <code class="whisper-mono" style="background-color: var(--cozy-bg-beige); padding: 2px 6px; border-radius: 4px;">kiosk.capcat.vn/ten-cua-ban</code> cực kỳ dễ dàng.
          </p>
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            <a href="https://doca.pet/profile" target="_blank" class="btn-create" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; background-color: var(--cozy-text-obsidian); color: #fff; border-radius: 8px; padding: 0.65rem 1rem; font-size: 0.85rem; font-weight: 600; width: 100%; transition: all 0.2s ease;">
              Về nhà doca.pet tạo góc Kiosk thôi ba ơi! <i class="ph-light ph-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- 2. GIAO DIỆN XEM CỬA HÀNG CHI TIẾT (DYNAMIC ROUTE `/{kios_name}`) -->
  <div id="kiosk-viewer-view" class="hidden">
    <main class="kiosk-viewer-page">
      <div class="container">
        
        <!-- TRẠNG THÁI LOADING -->
        <div id="kiosk-loading" class="text-center" style="padding: 6rem 0;">
          <i class="ph-light ph-spinner-gap spin" style="font-size: 3rem; color: var(--cozy-accent-identity); display: block; margin: 0 auto 1.5rem;"></i>
          <p class="whisper-mono">Đang tìm chiếc tủ Kiosk dễ thương...</p>
        </div>

        <!-- TRẠNG THÁI KHÔNG TÌM THẤY / CHƯA DUYỆT (404 HEALING) -->
        <div id="kiosk-not-found" class="text-center hidden" style="padding: 6rem 0;">
          <div style="font-size: 5rem; color: var(--cozy-text-charcoal); opacity: 0.6; margin-bottom: 1.5rem;">
            <i class="ph-light ph-storefront"></i>
          </div>
          <h1 class="not-found-title" style="color: var(--cozy-text-obsidian); margin-bottom: 1rem; font-weight: 800;">Tủ Kiosk này chưa lên kệ rồi ba ơi...</h1>
          <div class="healing-text-card">
            Góc nhỏ này đang được sửa soạn trang trí hoặc chưa mở cửa đón khách đâu ba ơi... <br/>
            Hẹn gặp lại cô/chú và các bạn sau nhé! 🐾
          </div>
          <a href="/" class="back-home-btn" style="margin-top: 2rem;">
            <i class="ph-light ph-house"></i> Ghé lại sân nhà thôi 🐾
          </a>
        </div>

        <!-- TRẠNG THÁI HIỂN THỊ CỬA HÀNG THỰC TẾ -->
        <div id="kiosk-content" class="kiosk-content hidden">
          <!-- Store Header -->
          <header class="store-header">
            <div class="store-header-inner">
              <div class="store-avatar-box">
                <img id="store-avatar-img" class="hidden" />
                <i id="store-avatar-icon" class="ph-light ph-paw"></i>
              </div>
              <div class="store-info-box">
                <div class="store-title-container">
                  <h1 id="store-title">Kiosk Của Nhà Sáng Tạo</h1>
                  <span id="store-status-badge">
                    <span class="status-dot"></span> Đang mở cửa
                  </span>
                </div>
                <p class="whisper-mono" id="store-slug-domain"></p>
                
                <!-- Bio / Lời chào -->
                <p id="store-bio" class="hidden"></p>
                
                <div id="store-channel-wrapper" class="store-channel-wrapper">
                  <!-- Các link mạng xã hội (icon tròn) chèn ở đây -->
                </div>
              </div>
            </div>
          </header>

          <!-- Divider -->
          <div class="store-divider">
            <span>Sản phẩm tuyển chọn</span>
            <i class="ph-light ph-sparkles"></i>
          </div>

          <!-- Links Grid -->
          <div id="links-grid-empty" class="text-center hidden" style="padding: 4rem 0; color: var(--cozy-text-charcoal); font-style: italic;">
            Kệ đồ của con đang trống trơn nè ba ơi... Ba ghé lại sau nha! 🐾
          </div>
          
          <div id="links-grid" class="products-grid">
            <!-- Các sản phẩm ở đây -->
          </div>

          <!-- Phân trang sản phẩm (Pagination) -->
          <div id="products-pagination" class="products-pagination"></div>
        </div>

        <!-- Polaroid Bottom Sheet -->
        <div id="polaroid-sheet-overlay" class="sheet-overlay">
          <div id="polaroid-bottom-sheet" class="polaroid-bottom-sheet">
            <div class="sheet-drag-handle"></div>
            
            <div class="sheet-content">
              <!-- Cột trái: Ảnh Polaroid -->
              <div class="content-left">
                <div class="polaroid-frame">
                  <img id="sheet-product-image" src="/images/brand/symbol-green.png" alt="Sản phẩm" />
                </div>
              </div>
              
              <!-- Cột phải: Thông tin -->
              <div class="content-right">
                <span class="sheet-badge">Lời nhắn của Creator</span>
                <h3 id="sheet-product-title" class="title-large">Tên sản phẩm</h3>
                <span id="sheet-price-platform" class="platform-badge" data-platform="shopee">Shopee</span>
              </div>

              <!-- Quote trãi dài 100% ở dưới cả 2 cột -->
              <div class="sheet-quote-fullwidth">
                <p id="sheet-product-quote" class="whisper-mono">"Mô tả cảm xúc..."</p>
              </div>
            </div>

            <!-- Hàng nút hành động -->
            <div class="sheet-actions">
              <button id="sheet-buy-now-btn" class="cozy-btn cozy-btn-primary cozy-btn-block action-btn-buy" style="border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                Mua sản phẩm <i class="ph-light ph-shopping-cart"></i>
              </button>
            </div>
          </div>
        </div>

      </div>
    </main>
  </div>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';

  function escapeHtml(str: string): string {
    return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Phân tích đường dẫn URL
    const pathParts = window.location.pathname.split('/').filter(p => p);
    let kiosName = pathParts[0]; // Lấy phần tử đầu tiên của path làm kios_name

    // Fallback cho môi trường test localhost khi chưa có DNS rewrite của Vercel
    if (!kiosName || kiosName === 'index.html') {
      const urlParams = new URLSearchParams(window.location.search);
      kiosName = urlParams.get('kiosk') || urlParams.get('name') || '';
    }

    const landingView = document.getElementById('kiosk-landing-view');
    const viewerView = document.getElementById('kiosk-viewer-view');

    if (!kiosName) {
      // 1. Hiển thị Landing Page
      if (landingView) landingView.classList.remove('hidden');
      return;
    }

    // 2. Hiển thị Viewer Page
    if (viewerView) viewerView.classList.remove('hidden');

    const supabaseUrl = window.PUBLIC_SUPABASE_URL || '';
    const supabaseAnonKey = window.PUBLIC_SUPABASE_ANON_KEY || '';

    if (!supabaseUrl || !supabaseAnonKey) {
      console.error('Thiếu cấu hình kết nối Supabase.');
      return;
    }

    const supabase = createClient(supabaseUrl, supabaseAnonKey);
    (window as any).supabase = supabase;

    // --- LOGIC GOOGLE AUTH & LEAD CAPTURE TRÊN NAVBAR ---
    const authContainer = document.getElementById('kiosk-nav-auth-container');

    function loginWithGoogle() {
      // Lưu referrer Kiosk hiện tại để ghi nhận nguồn leads sau callback
      localStorage.setItem('kiosk_login_referrer', kiosName || 'homepage');
      supabase.auth.signInWithOAuth({
        provider: 'google',
        options: {
          redirectTo: window.location.origin + window.location.pathname + window.location.search
        }
      });
    }

    function renderAuthUI(user: any) {
      if (!authContainer) return;

      if (user) {
        // Giao diện đã đăng nhập: hiển thị avatar dẫn tới trang hồ sơ cá nhân
        const avatarUrl = user.user_metadata?.avatar_url || 'https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=150';
        authContainer.innerHTML = `
          <a href="https://doca.pet/profile" target="_blank" title="Xem hồ sơ cá nhân của bạn">
            <img src="${avatarUrl}" alt="Avatar" class="kiosk-nav-avatar-img" />
          </a>
        `;

        // Tự động lưu vết leads (Lead Capture)
        const email = user.email;
        const refKiosk = localStorage.getItem('kiosk_login_referrer') || kiosName || 'homepage';
        const localFlagKey = `kiosk_lead_saved_${refKiosk}_${email}`;

        if (email && !localStorage.getItem(localFlagKey)) {
          supabase.from('kiosk_leads')
            .insert({
              email: email,
              kiosk_name: refKiosk,
              user_id: user.id
            })
            .then(({ error }: any) => {
              if (!error) {
                localStorage.setItem(localFlagKey, 'true');
                localStorage.removeItem('kiosk_login_referrer');
                console.log('[LeadCapture] Đã lưu vết người dùng thành công:', email);
              } else {
                console.error('[LeadCapture] Lỗi lưu vết người dùng:', error);
              }
            });
        }
      } else {
        // Giao diện chưa đăng nhập: hiển thị nút tròn logo Google 4 màu
        authContainer.innerHTML = `
          <button class="kiosk-nav-google-btn" title="Kết nối tài khoản Google">
            <svg viewBox="0 0 24 24" width="15" height="15" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
          </button>
        `;

        const btn = authContainer.querySelector('.kiosk-nav-google-btn');
        btn?.addEventListener('click', (e) => {
          e.preventDefault();
          loginWithGoogle();
        });
      }
    }

    // Lắng nghe sự thay đổi trạng thái đăng nhập
    supabase.auth.onAuthStateChange((event: string, session: any) => {
      renderAuthUI(session?.user || null);
    });

    // Lấy session ban đầu
    supabase.auth.getSession().then(({ data: { session } }: any) => {
      renderAuthUI(session?.user || null);
    }).catch((err: any) => {
      console.error('Lỗi khi lấy session cho Navbar:', err);
      renderAuthUI(null);
    });

    // --- Xử lý Đóng Mở Hamburger Menu trên Mobile ---
    const hamburgerBtn = document.getElementById('kiosk-hamburger-btn');
    const mobileMenu = document.getElementById('kiosk-mobile-menu');

    if (hamburgerBtn && mobileMenu) {
      hamburgerBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        mobileMenu.classList.toggle('active');
      });

      // Click ra ngoài thì tự động đóng menu
      document.addEventListener('click', (e) => {
        if (!mobileMenu.contains(e.target as Node) && e.target !== hamburgerBtn) {
          mobileMenu.classList.remove('active');
        }
      });
      document.addEventListener('touchstart', (e) => {
        if (!mobileMenu.contains(e.target as Node) && e.target !== hamburgerBtn) {
          mobileMenu.classList.remove('active');
        }
      });
    }

    const loadingEl = document.getElementById('kiosk-loading');
    const notFoundEl = document.getElementById('kiosk-not-found');
    const contentEl = document.getElementById('kiosk-content');

    const storeTitleEl = document.getElementById('store-title');
    const storeDomainEl = document.getElementById('store-slug-domain');
    const channelWrapper = document.getElementById('store-channel-wrapper');

    const linksGrid = document.getElementById('links-grid');
    const gridEmptyEl = document.getElementById('links-grid-empty');

    // Truy vấn thông tin Kiosk từ database
    supabase.from('creator_kiosks')
      .select('*')
      .eq('kios_name', kiosName)
      .eq('status', 'approved')
      .maybeSingle()
      .then(({ data: kiosk, error }: any) => {
        if (error || !kiosk) {
          if (loadingEl) loadingEl.classList.add('hidden');
          if (notFoundEl) notFoundEl.classList.remove('hidden');
          return;
        }

        // Đổi tiêu đề trình duyệt
        document.title = `Kiosk ${kiosk.kios_name.toUpperCase()} | Capcat 🐾`;

        // Điền thông tin Kiosk
        if (storeTitleEl) storeTitleEl.innerText = `Kiosk ${kiosk.kios_name.toLowerCase()}`;
        if (storeDomainEl) storeDomainEl.innerText = `kiosk.capcat.vn/${kiosk.kios_name}`;

        // Cập nhật ảnh đại diện Avatar Kiosk
        const storeAvatarImg = document.getElementById('store-avatar-img') as HTMLImageElement;
        const storeAvatarIcon = document.getElementById('store-avatar-icon');
        if (kiosk.avatar_url) {
          if (storeAvatarImg) {
            storeAvatarImg.src = kiosk.avatar_url;
            storeAvatarImg.classList.remove('hidden');
          }
          if (storeAvatarIcon) storeAvatarIcon.classList.add('hidden');
        } else {
          if (storeAvatarImg) storeAvatarImg.classList.add('hidden');
          if (storeAvatarIcon) storeAvatarIcon.classList.remove('hidden');
        }

        // Cập nhật Bio / Lời chào
        const storeBioEl = document.getElementById('store-bio');
        if (storeBioEl) {
          if (kiosk.bio) {
            storeBioEl.innerText = kiosk.bio;
            storeBioEl.classList.remove('hidden');
          } else {
            storeBioEl.classList.add('hidden');
          }
        }

        // Tạo liên kết kênh truyền thông (Social Links)
        if (channelWrapper) {
          let html = '';
          const socialLinks = kiosk.social_links || {};
          
          // Kiểm tra xem có bất kỳ link social mới nào được điền không
          const hasNewSocial = socialLinks.youtube || socialLinks.tiktok || socialLinks.facebook || socialLinks.instagram;
          
          if (hasNewSocial) {
            // Render danh sách icon tròn tinh tế cho các link được điền
            const platforms = [
              { key: 'youtube', icon: 'ph-light ph-youtube-logo', color: '#FF0000', label: 'YouTube' },
              { key: 'tiktok', icon: 'ph-light ph-tiktok-logo', color: 'var(--cozy-text-obsidian)', label: 'TikTok' },
              { key: 'facebook', icon: 'ph-light ph-facebook-logo', color: '#1877F2', label: 'Facebook' },
              { key: 'instagram', icon: 'ph-light ph-instagram-logo', color: '#E1306C', label: 'Instagram' }
            ];

            platforms.forEach(p => {
              const url = socialLinks[p.key];
              if (url) {
                html += `
                  <a href="${url}" target="_blank" class="store-channel-btn" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background-color: var(--cozy-bg-beige); border: 1px solid var(--cozy-border-light); font-size: 1.15rem; color: var(--cozy-text-obsidian); transition: all 0.2s ease;" title="${p.label}">
                    <i class="${p.icon}" style="color: ${p.color};"></i>
                  </a>
                `;
              }
            });
          } else if (kiosk.channel) {
            // Fallback cho kênh truyền thông chính kiểu cũ (nếu chưa cấu hình settings mới)
            let channelIcon = 'ph-light ph-link';
            let channelColor = 'var(--cozy-text-obsidian)';
            let channelText = 'Kênh truyền thông';

            const chanLower = kiosk.channel.toLowerCase();
            if (chanLower.includes('tiktok.com')) {
              channelIcon = 'ph-light ph-tiktok-logo';
              channelText = 'TikTok';
            } else if (chanLower.includes('youtube.com') || chanLower.includes('youtu.be')) {
              channelIcon = 'ph-light ph-youtube-logo';
              channelColor = '#FF0000';
              channelText = 'YouTube';
            } else if (chanLower.includes('facebook.com')) {
              channelIcon = 'ph-light ph-facebook-logo';
              channelColor = '#1877F2';
              channelText = 'Facebook';
            }

            html = `
              <a href="${kiosk.channel}" target="_blank" class="store-channel-btn" style="display: inline-flex; align-items: center; gap: 0.4rem; background-color: var(--cozy-bg-beige); border: 1px solid var(--cozy-border-light); padding: 0.35rem 0.85rem; border-radius: 20px; font-size: 0.78rem; font-weight: 600; text-decoration: none; color: var(--cozy-text-obsidian); transition: all 0.2s ease;">
                <i class="${channelIcon}" style="color: ${channelColor}; font-size: 1rem;"></i> <span>Ghé thăm ${channelText}</span>
              </a>
            `;
          }

          channelWrapper.innerHTML = html;
        }

        // Tải danh sách links sản phẩm đã duyệt của Kiosk
        supabase.from('kiosk_links')
          .select('*')
          .eq('kiosk_id', kiosk.id)
          .eq('status', 'approved')
          .order('created_at', { ascending: false })
          .then(({ data: links, error: linksErr }: any) => {
            if (loadingEl) loadingEl.classList.add('hidden');
            if (contentEl) contentEl.classList.remove('hidden');

            if (linksErr || !links || links.length === 0) {
              if (gridEmptyEl) gridEmptyEl.classList.remove('hidden');
              return;
            }

            if (gridEmptyEl) gridEmptyEl.classList.add('hidden');

            // Trigger GA4 view_kiosk event
            if (typeof (window as any).gtag === 'function') {
              (window as any).gtag('event', 'view_kiosk', {
                kiosk_name: kiosName,
                kiosk_id: kiosk.id,
                total_products: links ? links.length : 0
              });
            }

            // Gọi RPC tăng view_count của Kiosk trong Supabase
            if (supabase && typeof supabase.rpc === 'function') {
              supabase.rpc('increment_kiosk_views', { kiosk_id_param: kiosk.id })
                .then(({ error }: any) => {
                  if (error) console.error('[Analytics] Lỗi tăng views_count:', error);
                });
            }

            // Chỉ dành cho mục đích test phân trang và giao diện lưới trên local dev:
            if (links && links.length > 0 && kiosName === 'test' && (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')) {
              const baseLink = links[0];
              const testLinks = [];
              for (let i = 1; i <= 15; i++) {
                testLinks.push({
                  ...baseLink,
                  id: `${baseLink.id}-${i}`,
                  product_name: `${baseLink.product_name || 'Sản phẩm test'} #${i}`,
                  description: baseLink.description ? `${baseLink.description} (Mẫu test #${i})` : `Mô tả sản phẩm test #${i}`
                });
              }
              links = testLinks;
            }
            if (linksGrid) {
              linksGrid.innerHTML = links.map((link: any, idx: number) => {
                // Định danh nền tảng
                let linkPlatform = 'Shopee';
                try {
                  const urlObj = new URL(link.affiliate_url);
                  if (urlObj.hostname.includes('fahasa')) linkPlatform = 'Fahasa';
                } catch(e) {}

                const displayTitle = link.product_name || `Đề xuất mua sắm #${idx + 1}`;
                const displayImageUrl = link.product_image_url || "/images/brand/symbol-green.png";
                const hasImage = !!link.product_image_url;

                return `
                  <div class="product-card-v2" data-id="${link.id}" data-url="${escapeHtml(link.affiliate_url)}" data-name="${escapeHtml(displayTitle)}" data-image="${escapeHtml(displayImageUrl)}" data-desc="${escapeHtml(link.description || '')}" data-platform="${linkPlatform}" style="cursor: pointer;">
                    <div class="product-image-container">
                      <img 
                        src="${displayImageUrl}" 
                        alt="${escapeHtml(displayTitle)}" 
                        class="product-image ${!hasImage ? 'placeholder-logo' : ''}" 
                        loading="lazy" 
                        onload="this.classList.add('loaded')"
                      />
                    </div>
                    
                    <div class="product-meta">
                      <h4 class="product-title">${escapeHtml(displayTitle)}</h4>
                      ${link.description ? `<p class="product-quote">“ ${escapeHtml(link.description)} ”</p>` : ''}
                      <span class="platform-badge" data-platform="${linkPlatform.toLowerCase()}">
                        ${linkPlatform === 'Shopee' ? `
                          <svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor" style="display: inline-block; vertical-align: -0.5px; margin-right: 3px;">
                            <path d="M19 6h-2c0-2.76-2.24-5-5-5S7 3.24 7 6H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-7-3c1.66 0 3 1.34 3 3H9c0-1.66 1.34-3 3-3zm7 17H5V8h14v12zm-7-8c-1.66 0-3-1.34-3-3a1 1 0 1 0-2 0c0 2.76 2.24 5 5 5s5-2.24 5-5a1 1 0 1 0-2 0c0 1.66-1.34 3-3 3z"/>
                          </svg>
                        ` : ''}
                        ${linkPlatform}
                      </span>
                    </div>
                  </div>
                `;
              }).join('');

              // Logic phân trang client-side
              const productCards = linksGrid.children;
              const paginationContainer = document.getElementById('products-pagination');
              
              let currentPage = 1;
              const itemsPerPage = 10;
              
              function updateGrid() {
                if (!productCards.length) return;
                
                const totalItems = productCards.length;
                const totalPages = Math.ceil(totalItems / itemsPerPage);
                
                if (currentPage < 1) currentPage = 1;
                if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;
                
                const startIndex = (currentPage - 1) * itemsPerPage;
                const endIndex = startIndex + itemsPerPage;
                
                // Ẩn tất cả trước
                Array.from(productCards).forEach(card => {
                  (card as HTMLElement).style.display = 'none';
                });
                
                // Hiển thị các sản phẩm thuộc trang hiện tại
                Array.from(productCards).forEach((card, index) => {
                  if (index >= startIndex && index < endIndex) {
                    (card as HTMLElement).style.display = 'flex';
                  }
                });
                
                renderPagination(totalPages);
              }
              
              function renderPagination(totalPages: number) {
                if (!paginationContainer) return;
                
                if (totalPages <= 1) {
                  paginationContainer.innerHTML = '';
                  paginationContainer.style.display = 'none';
                  return;
                }
                
                paginationContainer.style.display = 'flex';
                let html = '';
                
                // Nút Prev
                html += `<button class="page-btn prev-btn" ${currentPage === 1 ? 'disabled' : ''} data-page="${currentPage - 1}"><i class="ph-light ph-caret-left"></i></button>`;
                
                // Các số trang
                for (let i = 1; i <= totalPages; i++) {
                  html += `<button class="page-btn num-btn ${currentPage === i ? 'active' : ''}" data-page="${i}">${i}</button>`;
                }
                
                // Nút Next
                html += `<button class="page-btn next-btn" ${currentPage === totalPages ? 'disabled' : ''} data-page="${currentPage + 1}"><i class="ph-light ph-caret-right"></i></button>`;
                
                paginationContainer.innerHTML = html;
                
                paginationContainer.querySelectorAll('.page-btn').forEach(btn => {
                  btn.addEventListener('click', (e) => {
                    const target = e.currentTarget as HTMLButtonElement;
                    if (target.disabled) return;
                    const pageNum = parseInt(target.getAttribute('data-page') || '1');
                    currentPage = pageNum;
                    updateGrid();
                    
                    // Cuộn mượt lên vị trí store-divider
                    const divider = document.querySelector('.store-divider');
                    divider?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                  });
                });
              }
              
              // Chạy lần đầu tiên
              updateGrid();

              // --- Xử lý Đóng/Mở Bottom Sheet Polaroid ---
              const sheetOverlay = document.getElementById('polaroid-sheet-overlay');
              const bottomSheet = document.getElementById('polaroid-bottom-sheet');
              const sheetImg = document.getElementById('sheet-product-image') as HTMLImageElement;
              const sheetTitle = document.getElementById('sheet-product-title');
              const sheetQuote = document.getElementById('sheet-product-quote');
              const sheetPricePlatform = document.getElementById('sheet-price-platform');
              const sheetBuyNowBtn = document.getElementById('sheet-buy-now-btn') as HTMLButtonElement;

               let activeProductUrl = '';
              let activeProductId = '';

              function openProductSheet(card: HTMLElement) {
                const url = card.getAttribute('data-url') || '';
                const name = card.getAttribute('data-name') || '';
                const image = card.getAttribute('data-image') || '';
                const desc = card.getAttribute('data-desc') || '';
                const platform = card.getAttribute('data-platform') || 'Shopee';
                const id = card.getAttribute('data-id') || '';

                activeProductUrl = url;
                activeProductId = id;

                // Trigger GA4 view_kiosk_product event
                if (typeof (window as any).gtag === 'function') {
                  (window as any).gtag('event', 'view_kiosk_product', {
                    kiosk_name: kiosName,
                    product_name: name,
                    product_platform: platform
                  });
                }

                if (sheetImg) {
                  sheetImg.src = image || "/images/brand/symbol-green.png";
                  if (!image) {
                    sheetImg.classList.add('placeholder-logo');
                  } else {
                    sheetImg.classList.remove('placeholder-logo');
                  }
                }
                if (sheetTitle) sheetTitle.textContent = name;
                
                if (sheetQuote) {
                  if (desc) {
                    sheetQuote.textContent = desc.startsWith('"') || desc.startsWith('“') ? desc : `“ ${desc} ”`;
                    sheetQuote.parentElement?.style.setProperty('display', 'block');
                  } else {
                    sheetQuote.parentElement?.style.setProperty('display', 'none');
                  }
                }

                if (sheetPricePlatform) {
                  sheetPricePlatform.setAttribute('data-platform', platform.toLowerCase());
                  if (platform.toLowerCase() === 'shopee') {
                    sheetPricePlatform.innerHTML = `
                      <svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor" style="display: inline-block; vertical-align: -0.5px; margin-right: 3px;">
                        <path d="M19 6h-2c0-2.76-2.24-5-5-5S7 3.24 7 6H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-7-3c1.66 0 3 1.34 3 3H9c0-1.66 1.34-3 3-3zm7 17H5V8h14v12zm-7-8c-1.66 0-3-1.34-3-3a1 1 0 1 0-2 0c0 2.76 2.24 5 5 5s5-2.24 5-5a1 1 0 1 0-2 0c0 1.66-1.34 3-3 3z"/>
                      </svg>Shopee`;
                  } else {
                    sheetPricePlatform.textContent = platform;
                  }
                }

                if (sheetBuyNowBtn) {
                  sheetBuyNowBtn.innerHTML = `Mua trên ${platform} <i class="ph-light ph-shopping-cart"></i>`;
                }

                sheetOverlay?.classList.add('open');
                document.body.style.overflow = 'hidden';
              }

              function closeProductSheet() {
                sheetOverlay?.classList.remove('open');
                document.body.style.overflow = '';
              }

              // Lắng nghe sự kiện click trên từng card sản phẩm
              Array.from(productCards).forEach((card: any) => {
                card.addEventListener('click', () => {
                  openProductSheet(card);
                });
              });

              // Đóng khi click ra ngoài overlay
              sheetOverlay?.addEventListener('click', (e) => {
                if (e.target === sheetOverlay) {
                  closeProductSheet();
                }
              });

              bottomSheet?.addEventListener('click', (e) => {
                e.stopPropagation();
              });

              // Click nút Mua ngay
              sheetBuyNowBtn?.addEventListener('click', () => {
                if (activeProductUrl) {
                  // Trigger GA4 click_kiosk_affiliate_link event
                  if (typeof (window as any).gtag === 'function') {
                    const name = sheetTitle ? sheetTitle.textContent : '';
                    const platform = sheetPricePlatform ? sheetPricePlatform.textContent : 'Shopee';
                    (window as any).gtag('event', 'click_kiosk_affiliate_link', {
                      kiosk_name: kiosName,
                      product_name: name,
                      product_platform: platform,
                      affiliate_url: activeProductUrl
                    });
                  }

                  // Gọi RPC tăng clicks_count của Link trong Supabase
                  if (activeProductId && supabase && typeof supabase.rpc === 'function') {
                    supabase.rpc('increment_link_clicks', { link_id_param: activeProductId })
                      .then(({ error }: any) => {
                        if (error) console.error('[Analytics] Lỗi tăng clicks_count:', error);
                      });
                  }

                  window.open(activeProductUrl, '_blank');
                }
              });
            }
          });
      });
  });
</script>

